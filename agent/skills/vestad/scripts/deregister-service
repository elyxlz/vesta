#!/usr/bin/env bash
# Remove a service registration from vestad. The counterpart to register-service.
#
# A registration outlives the process that created it: stopping a daemon frees the port
# but leaves vestad still advertising the name, and for one registered as publicly
# reachable that means an ungated route pointing at nothing. Anything that registers a
# service for the duration of a session must remove it when the session ends.
#
# Idempotent: removing a name that is not registered succeeds, so this is safe on every
# teardown path including one that runs twice.
#
# Usage: deregister-service <name>
#   deregister-service browser
set -euo pipefail
NAME="${1:?Usage: deregister-service <name>}"

WAIT_SECONDS="${REGISTER_SERVICE_WAIT:-30}"
# BOX_HOST comes from /run/vestad-env; vestad is the one owner of how to reach it
# (it runs natively on the host, never in a container). set -u fails loudly if it's
# missing, same as an unset VESTAD_PORT/AGENT_NAME already would.
URL="https://$BOX_HOST:$VESTAD_PORT/agents/$AGENT_NAME/services/$NAME"
DEADLINE=$(( $(date +%s) + WAIT_SECONDS ))

# --http1.1 because curl can exit 92 on an HTTP/2 stream error against the local gateway.
while :; do
    CODE=$(curl -sk --http1.1 -o /dev/null -w '%{http_code}' -X DELETE "$URL" \
        -H "X-Agent-Token: $AGENT_TOKEN") || CODE=""
    # 404 counts as success: the goal is "this name is not registered", and it already is not.
    case "$CODE" in
        2*|404) exit 0 ;;
    esac
    if [ "$(date +%s)" -ge "$DEADLINE" ]; then
        echo "deregister-service: vestad unreachable after ${WAIT_SECONDS}s; service '$NAME' still registered" >&2
        exit 1
    fi
    sleep 1
done
