#!/usr/bin/env bash
# Register a background service with vestad and print the assigned port.
# Pass --public only for something that must load with no credential at all (a
# whatsapp QR link, a shareable file link, an inbound webhook, a browser handover
# page). Everything else
# is private and is reached with the api key or a minted service key. The flag is
# always sent explicitly, so a service that once registered public becomes
# private again on its next registration.
# Registration is idempotent: vestad returns the same port for a given name on
# every call.
#
# vestad's HTTP API may not be up yet when the restart skill runs this (the
# daemon block can fire before vestad's API is back). Rather than pipe a refused
# connection's empty body into json (a raw traceback + empty port -> a portless
# daemon), poll until vestad answers with a port, up to REGISTER_SERVICE_WAIT
# seconds (default 30). On timeout, exit non-zero with a stderr message and no
# stdout, so `PORT=$(register-service ...) && start` short-circuits cleanly.
#
# Usage: register-service <name> [--public]
#   PORT=$(register-service tasks)
#   PORT=$(register-service file-host --public)

set -euo pipefail

NAME="${1:?Usage: register-service <name> [--public]}"
if [ "${2:-}" = "--public" ]; then
    REQUEST="{\"name\":\"$NAME\",\"public\":true}"
else
    REQUEST="{\"name\":\"$NAME\",\"public\":false}"
fi

WAIT_SECONDS="${REGISTER_SERVICE_WAIT:-30}"
# BOX_HOST comes from /run/vestad-env; vestad is the one owner of how to reach it
# (it runs natively on the host, never in a container). set -u below fails loudly if
# it's missing, same as an unset VESTAD_PORT/AGENT_NAME already would.
URL="https://$BOX_HOST:$VESTAD_PORT/agents/$AGENT_NAME/services"
DEADLINE=$(( $(date +%s) + WAIT_SECONDS ))

while :; do
    BODY=$(curl -sk -X POST "$URL" \
        -H "X-Agent-Token: $AGENT_TOKEN" -H 'Content-Type: application/json' \
        -d "$REQUEST") || BODY=""
    PORT=$(printf '%s' "$BODY" | python3 -c \
        'import sys, json
try:
    print(json.load(sys.stdin)["port"])
except Exception:
    sys.exit(1)' 2>/dev/null) || PORT=""
    if [ -n "$PORT" ]; then
        printf '%s\n' "$PORT"
        exit 0
    fi
    if [ "$(date +%s)" -ge "$DEADLINE" ]; then
        echo "register-service: vestad unreachable after ${WAIT_SECONDS}s; service '$NAME' not registered" >&2
        exit 1
    fi
    sleep 1
done
