#!/usr/bin/env python3
"""ocado: drive the user's Ocado account through Ocado's own web API.

Every call runs as an in-page fetch() inside the signed-in `browser` session
(default `ocado`), so the session cookies, the AWS WAF token and the CSRF token
are always the browser's own. Whatever this CLI changes is the user's real
account state, so the website shows it immediately.
"""

import argparse
import contextlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from datetime import UTC, datetime
from pathlib import Path

SESSION = os.environ.get("OCADO_SESSION", "ocado")
BASE = "https://www.ocado.com"
CRED = Path("~/.ocado/cred.json").expanduser()
CONF = Path("~/.ocado/config.json").expanduser()
REGION_DEFAULT = "9138094d-f307-46aa-a62d-86c8bdaeb4b9"  # England
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.IGNORECASE)

FETCH_JS = r"""(async (calls)=>{
 const st=window.__INITIAL_STATE__;
 if(!st) return JSON.stringify({error:'page-not-loaded'});
 if(!st.session?.isLoggedIn) return JSON.stringify({error:'not-logged-in'});
 const t=st.session?.csrf?.token;
 if(!t) return JSON.stringify({error:'no-csrf'});
 const out=[];
 for(const c of calls){
  const r=await fetch(c.path,{method:c.method,credentials:'include',headers:{
    'accept':'application/json; charset=utf-8','content-type':'application/json; charset=utf-8',
    'x-csrf-token':t,'ecom-request-source':'web'},
    body:c.body===undefined?undefined:JSON.stringify(c.body)});
  const tx=await r.text(); let b; try{b=JSON.parse(tx)}catch(e){b=tx.slice(0,800)}
  const waf=r.headers.get('x-amzn-waf-action');
  out.push({status:r.status,body:b,waf:waf});
  if(waf) break;
 }
 return JSON.stringify({loggedIn: !!window.__INITIAL_STATE__?.session?.isLoggedIn, results: out});
})"""


class OcadoError(Exception):
    pass


def browser(program, timeout=110):
    r = subprocess.run(
        ["browser", "exec", "--session", SESSION, "--timeout", str(timeout)],
        input=program,
        capture_output=True,
        text=True,
        timeout=timeout + 30,
        check=False,
    )
    raw = (r.stdout or r.stderr).strip().splitlines()
    if not raw:
        raise OcadoError("browser returned nothing")
    d = json.loads(raw[-1])
    if not d.get("ok"):
        err = d.get("error") or {}
        tail = (d.get("output") or {}).get("stderr", "")[-600:]
        raise OcadoError(f"browser: {err.get('code')} {err.get('message')} {tail}")
    return (d.get("output") or {}).get("stdout", "")


def api(calls):
    """Run a batch of {method, path, body?} calls in the page; return results.

    The result goes through a private temp file: browser stdout is capped, and
    product pages easily exceed it.
    """
    fd, tmp = tempfile.mkstemp(prefix="ocado-", suffix=".json")
    os.close(fd)
    prog = f"""
import json
info = page_info()
if 'www.ocado.com' not in (info.get('url') or '') or not js("!!window.__INITIAL_STATE__"):
    goto_url({BASE + "/"!r}); wait(4)
open({tmp!r}, "w").write(js({FETCH_JS!r} + "(" + {json.dumps(json.dumps(calls))} + ")"))
"""
    browser(prog)
    try:
        d = json.loads(Path(tmp).read_text())
    except (OSError, ValueError) as e:
        raise OcadoError(f"no readable result from the page: {e}") from e
    finally:
        with contextlib.suppress(OSError):
            Path(tmp).unlink()
    if d.get("error") == "not-logged-in":
        raise OcadoError("not logged in: run `ocado login`")
    if d.get("error"):
        raise OcadoError(f"Ocado page not usable ({d['error']}): retry, or check the `ocado` browser session")
    for r in d["results"]:
        if r.get("waf"):
            raise OcadoError(f"AWS WAF challenge ({r['waf']}): nothing after this call ran; reload ocado.com in the session and retry")
    return d["results"]


def call(method, path, body=None, ok=(200, 201, 202, 204)):
    c = {"method": method, "path": path}
    if body is not None:
        c["body"] = body
    r = api([c])[0]
    if r["status"] == 401:
        raise OcadoError("session expired: run `ocado login`")
    if r["status"] == 202 and r["body"] in ("", None):
        raise OcadoError(f"{method} {path} -> 202 with empty body (likely a bot challenge); outcome unknown, re-check state")
    if r["status"] not in ok:
        raise OcadoError(f"{method} {path} -> {r['status']}: {json.dumps(r['body'])[:600]}")
    return r["body"]


def gql(name, query, variables=None):
    b = call("POST", "/graphql", {"operationName": name, "query": query, "variables": variables or {}})
    if isinstance(b, dict) and b.get("errors"):
        raise OcadoError(f"graphql {name}: {json.dumps(b['errors'])[:600]}")
    return (b or {}).get("data") or {}


def conf():
    if CONF.exists():
        return json.loads(CONF.read_text())
    return {}


def region():
    return conf().get("regionId", REGION_DEFAULT)


def money(m):
    return f"£{m['amount']}" if m else "-"


def out(obj, args):
    if args.json:
        print(json.dumps(obj, indent=None if not args.pretty else 2, ensure_ascii=False))
        return True
    return False


# ---------- products ----------


def resolve_product(ref):
    """Accept a productId (uuid) or retailerProductId (the number in product URLs)."""
    if UUID_RE.match(ref):
        return ref.lower()
    if ref.isdigit():
        b = call("GET", f"/api/webproductpagews/v5/products/bop?retailerProductId={ref}")
        return b["product"]["productId"]
    m = re.search(r"/products/[^/]+/(\d+)", ref)
    if m:
        return resolve_product(m.group(1))
    raise OcadoError(f"not a product id/sku/url: {ref!r} (use `ocado search` to find one)")


def decorate(ids):
    if not ids:
        return {}
    b = call("PUT", "/api/webproductpagews/v6/products", list(ids))
    return {p["productId"]: p for p in b.get("products", [])}


def purl(p):
    """Product page link. Ocado redirects any slug to the canonical one; this mimics it."""
    slug = re.sub(r"[^a-z0-9]+", "-", (p.get("name") or "x").lower()).strip("-") or "x"
    return f"{BASE}/products/{slug}/{p.get('retailerProductId')}"


def prow(p, qty=None):
    q = f"{qty}x " if qty is not None else ""
    promo = "; ".join(x.get("description", "") for x in p.get("promotions") or [] if x.get("description"))
    avail = "" if p.get("available", True) else " [UNAVAILABLE]"
    return (
        f"{q}{p.get('name')} ({p.get('packSizeDescription', '')}) {money(p.get('price'))}{avail}"
        f"  sku={p.get('retailerProductId')} id={p['productId']}" + (f"  promo: {promo}" if promo else "") + f"\n    {purl(p)}"
    )


def cmd_search(a):
    from urllib.parse import quote

    n = a.limit
    b = call("GET", f"/api/webproductpagews/v6/product-pages/search?q={quote(a.query)}&tag=web&maxPageSize={n}&maxProductsToDecorate={n}")
    prods = [p for g in b.get("productGroups", []) for p in g.get("decoratedProducts", [])][:n]
    if out(prods, a):
        return
    for p in prods:
        print(prow(p))


def cmd_product(a):
    pid = resolve_product(a.product)
    p = decorate([pid]).get(pid)
    if out(p, a):
        return
    print(prow(p))


# ---------- trolley ----------


def cart():
    return call("GET", "/api/cart/v1/carts/active")


def cmd_trolley(a):
    c = cart()
    ids = [i["productId"] for i in c.get("items", [])]
    meta = decorate(ids)
    rows = []
    for i in c.get("items", []):
        p = meta.get(i["productId"], {"productId": i["productId"], "name": "?"})
        rows.append(
            {
                "productId": i["productId"],
                "retailerProductId": p.get("retailerProductId"),
                "name": p.get("name"),
                "pack": p.get("packSizeDescription"),
                "quantity": i.get("quantity"),
                "linePrice": (i.get("finalPrice") or {}).get("amount"),
            }
        )
    g = c.get("activeCheckoutGroup") or {}
    tot = c.get("activeCheckoutGroupTotals") or {}
    summary = {
        "items": rows,
        "total": tot.get("itemPriceAfterPromos"),
        "savings": tot.get("savingsPrice"),
        "minimum": g.get("minimumCheckoutThreshold"),
        "canCheckout": g.get("canCheckout"),
        "restrictions": g.get("checkoutRestrictions"),
        "editingOrderId": g.get("orderId"),
    }
    if out(summary, a):
        return
    for r in rows:
        print(f"{r['quantity']}x {r['name']} ({r['pack']}) £{r['linePrice']}  sku={r['retailerProductId']} id={r['productId']}")
    print(f"-- {len(rows)} lines, total {money(summary['total'])}, saved {money(summary['savings'])}, minimum {money(summary['minimum'])}")
    if summary["restrictions"]:
        print(f"-- checkout blocked by: {', '.join(summary['restrictions'])}")


def apply_qty(pairs):
    return call("POST", "/api/cart/v1/carts/active/apply-quantity", [{"productId": pid, "quantity": q} for pid, q in pairs])


def cmd_add(a):
    pid = resolve_product(a.product)
    b = apply_qty([(pid, a.qty)])
    lim = b.get("limitedItems") or []
    un = b.get("unavailableData") or {}
    print(
        json.dumps(
            {
                "added": pid,
                "qty": a.qty,
                "limited": lim,
                "unavailable": un,
                "total": ((b.get("basketUpdateResult") or {}).get("totals") or {}).get("itemPriceAfterPromos"),
            }
        )
    )


def cmd_remove(a):
    pid = resolve_product(a.product)
    c = cart()
    have = next((i.get("quantity", 0) for i in c.get("items", []) if i["productId"] == pid), 0)
    if not have:
        raise OcadoError("that product is not in the trolley")
    q = have if a.all or a.qty is None else min(a.qty, have)
    apply_qty([(pid, -q)])
    print(json.dumps({"removed": pid, "qty": q, "left": have - q}))


def cmd_set(a):
    pid = resolve_product(a.product)
    c = cart()
    have = next((i.get("quantity", 0) for i in c.get("items", []) if i["productId"] == pid), 0)
    if a.qty != have:
        apply_qty([(pid, a.qty - have)])
    print(json.dumps({"product": pid, "was": have, "now": a.qty}))


def cmd_restore(a):
    """Make the trolley match a snapshot saved with `ocado --json trolley > file`."""
    want = {i["productId"]: i["quantity"] for i in json.loads(Path(a.snapshot).read_text())["items"]}
    have = {i["productId"]: i.get("quantity", 0) for i in cart().get("items", [])}
    deltas = [(pid, want.get(pid, 0) - have.get(pid, 0)) for pid in set(want) | set(have)]
    deltas = [(pid, d) for pid, d in deltas if d]
    removes = [pid for pid, d in deltas if d < 0]
    if removes and not a.yes:
        print(json.dumps({"wouldChange": len(deltas), "wouldReduceOrRemove": len(removes), "snapshotLines": len(want)}))
        raise OcadoError("restore would reduce/remove lines: check the plan above, then re-run with --yes")
    if deltas:
        apply_qty(deltas)
    print(json.dumps({"changedLines": len(deltas)}))


def cmd_empty(a):
    if not a.yes:
        raise OcadoError("empties the whole trolley: re-run with --yes")
    call("DELETE", "/api/cart/v1/carts/active/items")
    print(json.dumps({"emptied": True}))


# ---------- orders ----------


def order(oid):
    b = call("GET", f"/api/order/v6/orders/{oid}")
    return b["entities"]["order"][oid]


def cmd_orders(a):
    q = (
        "query GetCompletedOrders($first: Int!, $after: String) { completedOrders(first: $first, after: $after) "
        "{ edges { node { orderId status prices { total { amount currency } } slot { ... on InternalOrderSlot { start end } } } } } }"
    )
    rows = []
    try:
        up = gql(
            "GetUpcomingOrders",
            "query GetUpcomingOrders { ordersUpcoming { orderId status prices { total { amount currency } } "
            "editInfo { isEditable isUnderEdit guaranteedEditableBy } slot { timeWindow { start end } } } }",
        )["ordersUpcoming"]
        rows.extend(
            {
                "orderId": o["orderId"],
                "status": o["status"],
                "total": o["prices"]["total"]["amount"],
                "start": ((o.get("slot") or {}).get("timeWindow") or {}).get("start"),
                "editable": (o.get("editInfo") or {}).get("isEditable"),
                "editableBy": (o.get("editInfo") or {}).get("guaranteedEditableBy"),
            }
            for o in up
        )
    except OcadoError as e:
        print(f"warn: upcoming orders: {e}", file=sys.stderr)
    done = gql("GetCompletedOrders", q, {"first": a.limit})["completedOrders"]["edges"]
    for e in done:
        n = e["node"]
        rows.append(
            {
                "orderId": n["orderId"],
                "status": n["status"],
                "total": n["prices"]["total"]["amount"],
                "start": (n.get("slot") or {}).get("start"),
            }
        )
    if out(rows, a):
        return
    for r in rows:
        extra = f"  editable until {r['editableBy']}" if r.get("editable") else ""
        print(f"{r['orderId']}  {r['status']:<10} £{r['total']:>7}  {r['start']}{extra}")


def cmd_order(a):
    o = order(a.order_id)
    gp = o.get("groupedProducts") or {}
    if out(o, a):
        return
    t = o["orderTotals"]
    print(f"order {o['orderId']} {o['status']}  {o['dates']['deliveryStartDate']} -> {o['dates']['deliveryEndDate']}")
    print(f"  {o.get('address')}")
    for p in gp.get("products", []):
        pr = (p.get("prices") or {}).get("offered") or (p.get("prices") or {}).get("retail")
        print(
            f"  {p['quantity']}x {p['name']} ({(p.get('packInfo') or {}).get('packSizeDescription', '')}) {money(pr)}"
            f"  sku={p['retailerProductId']} id={p['productId']}"
        )
    for k in ("substitutes", "missings", "returns"):
        for p in gp.get(k, []):
            print(f"  [{k[:-1]}] {p.get('quantity')}x {p.get('name')}  id={p.get('productId')}")
    print(
        f"  retail {money(t['retailPrice'])}, promos -{money(t['promoSavings'])}, vouchers -{money(t['vouchersSavingsPrice'])},"
        f" total {money(t['totalPrice'])} ({o.get('totalItems')} items)"
    )


def cmd_order_again(a):
    """Ocado's own 'Order again': puts a past order's items into the trolley."""
    if a.empty_first and not a.yes:
        raise OcadoError("--empty-first replaces the current trolley: add --yes")
    if a.empty_first:
        call("DELETE", "/api/cart/v1/carts/active/items")
    b = call("POST", "/api/cart/v1/carts/active/buy-again", {"orderId": a.order_id})
    added = b.get("addedItems") or []
    notadded = b.get("notAddedItems") or b.get("unavailableItems") or []
    print(json.dumps({"orderId": a.order_id, "added": len(added), "notAdded": notadded if a.json else len(notadded)}))


def cmd_edit(a):
    """Open a pending order for amendment: it becomes the active trolley."""
    if a.cancel:
        call("DELETE", f"/api/customersessions/v2/sessions/order-edit/{a.order_id}?regionId={region()}")
        print(json.dumps({"orderId": a.order_id, "edit": "discarded"}))
    else:
        call("POST", "/api/customersessions/v2/sessions/order-edit", {"orderId": a.order_id, "regionId": region()})
        print(
            json.dumps({"orderId": a.order_id, "edit": "open", "next": "change items with add/remove/set, then save on the website checkout"})
        )


# ---------- favourites ----------


def cmd_favs(a):
    b = call(
        "GET",
        f"/api/webproductpagews/v6/product-pages/favorites?sortOptionId=favorite&tag=web&maxPageSize={a.limit}&maxProductsToDecorate={a.limit}",
    )
    prods = [p for g in b.get("productGroups", []) for p in g.get("decoratedProducts", [])]
    more = [i for g in b.get("productGroups", []) for i in g.get("otherProductIds", [])]
    if out({"products": prods, "moreIds": more}, a):
        return
    for p in prods:
        print(prow(p))
    if more:
        print(f"-- +{len(more)} more (raise --limit)")


def cmd_fav(a):
    pid = resolve_product(a.product)
    m = "PUT" if a.action == "add" else "DELETE"
    call(m, f"/api/customer-favorites/v1/customers/favorites/{pid}")
    print(json.dumps({"favourite": a.action, "productId": pid}))


# ---------- regulars ----------


def cmd_regulars(a):
    regs = call("GET", "/api/regulars/v1/regulars")
    meta = decorate([r["productId"] for r in regs]) if regs else {}
    if out(regs, a):
        return
    if not regs:
        print("no regulars")
    for r in regs:
        p = meta.get(r["productId"], {"productId": r["productId"], "name": "?"})
        print(f"{r.get('quantity')}x every {r.get('frequency')}: {prow(p)}")


def cmd_regular(a):
    pid = resolve_product(a.product)
    if a.action == "remove":
        call("DELETE", f"/api/regulars/v1/regulars/{pid}")
        print(json.dumps({"regular": "removed", "productId": pid}))
        return
    regs = call("GET", "/api/regulars/v1/regulars")
    exists = any(r["productId"] == pid for r in regs)
    body = {"productId": pid, "quantity": a.qty, "frequency": a.frequency}
    call("PUT" if exists else "POST", "/api/regulars/v1/regulars", body)
    print(json.dumps({"regular": "updated" if exists else "added", **body}))


# ---------- shopping lists ----------

LISTS_Q = (
    "query GetShoppingLists($first: Int) { shoppingLists { shoppingListId name productCount "
    "prices { discountedPrice { amount currency } } products(first: $first) { productId description } } }"
)
LIST_Q = (
    "query GetShoppingList($shoppingListId: ID!) { shoppingList(shoppingListId: $shoppingListId) { shoppingListId name "
    "productCount lastModifiedDateTime prices { discountedPrice { amount currency } } products { productId } } }"
)


def find_list(ref):
    lists = gql("GetShoppingLists", LISTS_Q, {"first": 1})["shoppingLists"]
    for sl in lists:
        if sl["shoppingListId"] == ref:
            return sl
    named = [sl for sl in lists if sl["name"].lower() == ref.lower()]
    if len(named) > 1:
        raise OcadoError(f"{len(named)} lists are called {ref!r}: use the id ({', '.join(sl['shoppingListId'] for sl in named)})")
    if named:
        return named[0]
    raise OcadoError(f"no shopping list {ref!r}; have: {', '.join(sl['name'] for sl in lists) or 'none'}")


def mut(name, field, inp_name, inp, sel="success"):
    q = f"mutation {name}(${inp_name}: {name}Input!) {{ {field}({inp_name}: ${inp_name}) {{ {sel} }} }}"
    r = gql(name, q, {inp_name: inp})[field]
    if isinstance(r, dict) and r.get("success") is False:
        raise OcadoError(f"{name} refused: {r.get('failureReason') or 'no reason given'}")
    return r


def cmd_lists(a):
    lists = gql("GetShoppingLists", LISTS_Q, {"first": 1})["shoppingLists"]
    if out(lists, a):
        return
    if not lists:
        print("no shopping lists")
    for sl in lists:
        print(
            f"{sl['name']}  ({sl['productCount']} items, {money((sl.get('prices') or {}).get('discountedPrice'))})  id={sl['shoppingListId']}"
        )


def cmd_list(a):
    if a.action == "create":
        r = mut(
            "ShoppingListCreate",
            "shoppingListCreate",
            "shoppingListCreateInput",
            {"name": a.name, "productIds": [resolve_product(p) for p in a.products]},
            "success failureReason shoppingList { shoppingListId }",
        )
        print(json.dumps(r))
        return
    sl = find_list(a.list)
    lid = sl["shoppingListId"]
    if a.action == "show":
        d = gql("GetShoppingList", LIST_Q, {"shoppingListId": lid})["shoppingList"]
        meta = decorate([p["productId"] for p in d["products"]])
        if out({**d, "productsDecorated": list(meta.values())}, a):
            return
        print(f"{d['name']} ({d['productCount']} items, {money((d.get('prices') or {}).get('discountedPrice'))})")
        for p in d["products"]:
            print("  " + prow(meta.get(p["productId"], {"productId": p["productId"], "name": "?"})))
    elif a.action == "rename":
        print(
            json.dumps(
                mut(
                    "ShoppingListUpdateName",
                    "shoppingListUpdateName",
                    "shoppingListUpdateNameInput",
                    {"shoppingListId": lid, "name": a.name},
                    "shoppingList { name }",
                )
            )
        )
    elif a.action == "delete":
        if not a.yes:
            raise OcadoError(f"deletes list {sl['name']!r} ({sl['productCount']} items): re-run with --yes")
        print(json.dumps(mut("ShoppingListDelete", "shoppingListDelete", "shoppingListDeleteInput", {"shoppingListId": lid})))
    elif a.action in ("add", "remove"):
        res = []
        for p in a.products:
            pid = resolve_product(p)
            if a.action == "add":
                r = mut(
                    "ShoppingListAddProduct",
                    "shoppingListAddProduct",
                    "shoppingListAddProductInput",
                    {"shoppingListId": lid, "productId": pid},
                    "success failureReason",
                )
            else:
                r = mut(
                    "ShoppingListRemoveProduct",
                    "shoppingListRemoveProduct",
                    "shoppingListRemoveProductInput",
                    {"shoppingListId": lid, "productId": pid},
                )
            res.append({"productId": pid, **r})
        print(json.dumps(res))
    elif a.action == "to-trolley":
        q = (
            "mutation CartAddShoppingList($addShoppingListInput: CartAddShoppingListInput!) "
            "{ cartAddShoppingList(addShoppingListInput: $addShoppingListInput) "
            "{ successfulUpdates { product { productId } quantity } unsuccessfulUpdates { product { productId } quantity reason } } }"
        )
        r = gql("CartAddShoppingList", q, {"addShoppingListInput": {"shoppingListId": lid}})["cartAddShoppingList"]
        print(json.dumps({"added": len(r["successfulUpdates"]), "failed": r["unsuccessfulUpdates"]}))


# ---------- delivery slots ----------


def destination():
    c = conf()
    if c.get("deliveryDestinationId"):
        return c["deliveryDestinationId"]
    return cart().get("deliveryDestinationId")


def cmd_slots(a):
    b = call(
        "POST",
        "/api/ecomslots/v2/slots",
        {
            "deliveryDestinationId": destination(),
            "regionId": region(),
            "shippingGroupType": "default home delivery",
            "displayConfiguration": "DELIVERY_METHOD",
            "numberOfDays": a.days,
        },
    )
    rows = [
        {
            "slotId": s["slotId"],
            "start": s["slotWindow"]["startTime"],
            "end": s["slotWindow"]["endTime"],
            "price": (s.get("deliveryPrice") or {}).get("amount", "-"),
            "attributes": s.get("attributes"),
        }
        for car in b.get("carriers", [])
        for day in car.get("gridSlots", [])
        for s in day.get("slots", [])
        if a.all or "AVAILABLE" in s.get("attributes", [])
    ]
    rows.sort(key=lambda r: r["start"])
    if out(rows, a):
        return
    for r in rows:
        print(f"{r['start'][:16]} -> {r['end'][11:16]}  £{r['price']}  {','.join(r['attributes'] or [])}  id={r['slotId']}")


