def _aware(ts):
    t = datetime.fromisoformat(ts)
    return t if t.tzinfo else t.replace(tzinfo=UTC)


def latest_otp(since_iso, seen):
    """Newest Ocado login code received after since_iso. The body is saved to a
    private temp dir and deleted at once, so the code never lingers on disk."""
    import shutil

    r = subprocess.run(
        ["microsoft", "email", "list", "--account", account_email(), "--since", since_iso[:10], "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if r.returncode != 0:
        raise OcadoError(f"microsoft email list failed: {(r.stderr or r.stdout)[-300:]}")
    msgs = json.loads(r.stdout or "[]")
    if not isinstance(msgs, list):
        raise OcadoError(f"microsoft email list: unexpected answer {str(msgs)[:200]}")
    since = _aware(since_iso)
    for m in msgs:
        if m["id"] in seen:
            continue
        subj = (m.get("subject") or "").lower()
        rec = m.get("receivedDateTime") or m.get("received") or ""
        if not ("ocado" in json.dumps(m.get("from", "")).lower() and "code" in subj and rec and _aware(rec) >= since):
            continue
        seen.add(m["id"])
        d = tempfile.mkdtemp(prefix="ocado-otp-")
        body = ""
        try:
            dest = Path(d) / "body.txt"
            subprocess.run(
                ["microsoft", "email", "get", "--account", account_email(), "--id", m["id"], "--no-attachments", "--save-to", str(dest)],
                capture_output=True,
                text=True,
                check=False,
            )
            if dest.exists():
                body = dest.read_text()
        finally:
            shutil.rmtree(d, ignore_errors=True)
        mm = re.search(r"log in to your Ocado account\.\s*(\d{4,8})", body)
        if mm:
            return mm.group(1)
    return None


def account_email():
    return json.loads(CRED.read_text())["username"]


DEEP = (
    "window.__deep=(sel)=>{const out=[];const walk=(root)=>{root.querySelectorAll(sel).forEach(e=>out.push(e));"
    "root.querySelectorAll('*').forEach(e=>{if(e.shadowRoot)walk(e.shadowRoot)})};walk(document);return out};"
)
BOX_JS = (
    "(()=>{const e=__deep('input[name=NAME]')[0];if(!e)return null;e.scrollIntoView({block:'center'});"
    "const r=e.getBoundingClientRect();return [r.x+r.width/2,r.y+r.height/2]})()"
)
LOGGED_IN_JS = "location.hostname==='www.ocado.com' && !!window.__INITIAL_STATE__?.session?.isLoggedIn"
OTP_FORM_JS = (
    "(()=>{const all=[];const walk=(root)=>{root.querySelectorAll('*').forEach(e=>{all.push(e);if(e.shadowRoot)walk(e.shadowRoot)})};"
    "walk(document);const i=all.find(e=>e.name==='otpVerify');const a=i.getBoundingClientRect();"
    r"const b=all.filter(e=>e.children.length===0&&/^\s*submit code\s*$/i.test(e.textContent||''))"
    ".map(e=>{const q=e.getBoundingClientRect();return [q.x+q.width/2,q.y+q.height/2]});"
    "return {inp:[a.x+a.width/2,a.y+a.height/2],btn:b}})()"
)


def cmd_login(_a):
    """Sign in with ~/.ocado/cred.json; fetch the emailed one-time code from the user's inbox."""
    since = time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime(time.time() - 30))
    seen = set()
    prog = f"""
import json
c = json.load(open({str(CRED)!r}))
goto_url("https://www.ocado.com/login"); wait(6)
js({DEEP!r})
js("(()=>{{const b=[...document.querySelectorAll('button')].find(b=>/^(Allow All|Accept)$/i.test(b.innerText.trim()));if(b)b.click()}})()")
if js("!!window.__INITIAL_STATE__?.session?.isLoggedIn"):
    print("ALREADY"); raise SystemExit
def box(n):
    return js({BOX_JS!r}.replace("NAME", n))
for n, v in (("usernamelogin", c["username"]), ("passwordlogin", c["password"])):
    xy = box(n)
    if not xy: print("NOFORM"); raise SystemExit
    click_at_xy(*xy); wait(0.3); press_key("a", 2); press_key("Backspace"); type_text(v); wait(0.3)
press_key("Enter"); wait(8)
js({DEEP!r})
print("OTP" if js("__deep('input[name=otpVerify]').length>0") else ("IN" if js({LOGGED_IN_JS!r}) else "STUCK"))
"""
    st = browser(prog, 120).strip().splitlines()[-1]
    if st in ("ALREADY", "IN"):
        print(json.dumps({"login": "ok", "via": st.lower()}))
        return
    if st != "OTP":
        raise OcadoError(
            f"login did not reach the code step ({st}); try `browser handover start --session {SESSION} --url https://www.ocado.com/login`"
        )
    code = None
    for _ in range(12):
        time.sleep(10)
        code = latest_otp(since, seen)
        if code:
            break
    if not code:
        raise OcadoError("no Ocado code email arrived in 2 minutes")
    prog2 = f"""
code = {code!r}
js({DEEP!r})
r = js({OTP_FORM_JS!r})
click_at_xy(*r['inp']); wait(0.3); type_text(code); wait(0.5)
if r['btn']: click_at_xy(*r['btn'][0])
else: press_key("Enter")
wait(12)
print("IN" if js({LOGGED_IN_JS!r}) else "STUCK")
"""
    st2 = browser(prog2, 90).strip().splitlines()[-1]
    if st2 != "IN":
        raise OcadoError("code submitted but still on the sign-in page")
    print(json.dumps({"login": "ok", "via": "password+code"}))


def pos_int(v):
    n = int(v)
    if n < 1:
        raise argparse.ArgumentTypeError("must be 1 or more")
    return n


def nonneg_int(v):
    n = int(v)
    if n < 0:
        raise argparse.ArgumentTypeError("must be 0 or more")
    return n


ORDER_RE = re.compile(r"^\d{6,20}$")


def order_id(v):
    if not ORDER_RE.match(v):
        raise argparse.ArgumentTypeError("order ids are digits only (see `ocado orders`)")
    return v


def build_parser():
    ap = argparse.ArgumentParser(prog="ocado", description="Ocado account: trolley, orders, favourites, regulars, shopping lists, slots")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--pretty", action="store_true", help="indent --json output")
    sp = ap.add_subparsers(dest="cmd", required=True)

    sp.add_parser("status", help="is the browser session signed in")
    sp.add_parser("login", help="sign in (password from ~/.ocado/cred.json, code from the inbox)")

    s = sp.add_parser("search", help="search products")
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=10)
    s = sp.add_parser("product", help="one product by id, sku or URL")
    s.add_argument("product")

    add_trolley_cmds(sp)
    add_account_cmds(sp)
    return ap


def add_trolley_cmds(sp):
    sp.add_parser("trolley", help="what's in the trolley now")
    s = sp.add_parser("add", help="add to trolley")
    s.add_argument("product")
    s.add_argument("--qty", type=pos_int, default=1)
    s = sp.add_parser("remove", help="remove from trolley (all of it by default)")
    s.add_argument("product")
    s.add_argument("--qty", type=pos_int)
    s.add_argument("--all", action="store_true")
    s = sp.add_parser("set", help="set an exact trolley quantity (0 removes)")
    s.add_argument("product")
    s.add_argument("qty", type=nonneg_int)
    s = sp.add_parser("restore", help="make the trolley match a saved `--json trolley` snapshot")
    s.add_argument("snapshot")
    s.add_argument("--yes", action="store_true")
    s = sp.add_parser("empty", help="empty the trolley")
    s.add_argument("--yes", action="store_true")


def add_account_cmds(sp):
    s = sp.add_parser("orders", help="upcoming + past orders")
    s.add_argument("--limit", type=int, default=10)
    s = sp.add_parser("order", help="one order's items and totals")
    s.add_argument("order_id", type=order_id)
    s = sp.add_parser("order-again", help="add a past order's items to the trolley (Ocado's Order again)")
    s.add_argument("order_id", type=order_id)
    s.add_argument("--empty-first", action="store_true")
    s.add_argument("--yes", action="store_true")
    s = sp.add_parser("edit", help="open (or --cancel) amendment of a pending order")
    s.add_argument("order_id", type=order_id)
    s.add_argument("--cancel", action="store_true")

    s = sp.add_parser("favourites", aliases=["favs"], help="list favourites")
    s.add_argument("--limit", type=int, default=50)
    s = sp.add_parser("fav", help="add/remove a favourite")
    s.add_argument("action", choices=["add", "remove"])
    s.add_argument("product")

    sp.add_parser("regulars", help="list regulars")
    s = sp.add_parser("regular", help="add/update/remove a regular")
    s.add_argument("action", choices=["add", "remove"])
    s.add_argument("product")
    s.add_argument("--qty", type=pos_int, default=1)
    s.add_argument("--frequency", default="WEEKLY", choices=["WEEKLY", "FORTNIGHTLY", "MONTHLY"])

    sp.add_parser("lists", help="shopping lists")
    s = sp.add_parser("list", help="shopping list actions")
    s.add_argument("action", choices=["show", "create", "rename", "delete", "add", "remove", "to-trolley"])
    s.add_argument("list", nargs="?", help="list name or id (not used by create)")
    s.add_argument("products", nargs="*", help="product ids/skus (add/remove/create)")
    s.add_argument("--name", help="name for create/rename")
    s.add_argument("--yes", action="store_true")

    s = sp.add_parser("slots", help="delivery slots")
    s.add_argument("--days", type=int, default=7)
    s.add_argument("--all", action="store_true")
    s = sp.add_parser("reserve", help="reserve a delivery slot")
    s.add_argument("slot_id")


def main():
    ap = build_parser()
    argv = sys.argv[1:]
    flags = [x for x in argv if x in ("--json", "--pretty")]
    a = ap.parse_args(flags + [x for x in argv if x not in ("--json", "--pretty")])
    if a.cmd == "list" and a.action == "create":
        if not a.name:
            a.name = a.list
            a.list = None
        elif a.list:
            a.products = [a.list, *a.products]
        if not a.name:
            ap.error("list create needs a name")
    elif a.cmd == "list" and not a.list:
        ap.error("which list?")
    fn = {
        "status": cmd_status,
        "login": cmd_login,
        "search": cmd_search,
        "product": cmd_product,
        "trolley": cmd_trolley,
        "add": cmd_add,
        "remove": cmd_remove,
        "set": cmd_set,
        "restore": cmd_restore,
        "empty": cmd_empty,
        "orders": cmd_orders,
        "order": cmd_order,
        "order-again": cmd_order_again,
        "edit": cmd_edit,
        "favourites": cmd_favs,
        "favs": cmd_favs,
        "fav": cmd_fav,
        "regulars": cmd_regulars,
        "regular": cmd_regular,
        "lists": cmd_lists,
        "list": cmd_list,
        "slots": cmd_slots,
        "reserve": cmd_reserve,
    }[a.cmd]
    try:
        fn(a)
    except OcadoError as e:
        print(f"ocado: {e}", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("ocado: the browser call timed out; a write may or may not have landed, check with `ocado trolley`", file=sys.stderr)
        sys.exit(2)
    except (KeyError, TypeError, ValueError) as e:
        print(
            f"ocado: unexpected response shape ({type(e).__name__}: {e}); if this was a write, check state with `ocado trolley`",
            file=sys.stderr,
        )
        sys.exit(2)


if __name__ == "__main__":
    main()
