#!/bin/sh
set -eu

# `file-host` on PATH. The skill's whole surface is its daemon, so this forwards
# `file-host daemon <action>` to the lifecycle script.

SKILL_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

if [ "${1:-}" = "daemon" ]; then
  shift
  exec "$SKILL_DIR/scripts/daemon" "$@"
fi

echo "usage: file-host daemon <start|stop|restart|status>" >&2
exit 1
