#!/bin/sh
set -e

# node_modules/ and dist/ are untracked build artifacts, so a checkout or a clean can drop them
# while the box keeps running, and a release can leave both present but behind what the source now
# needs. Reconciling both here, before every launch, lets the service heal itself on the next
# restart rather than serving 404s or handing out the previous bundle. Idempotent: on a normal
# restart both are current and this goes straight to the preview server, at the cost of two hashes.
# Dependencies first, because the build needs them present before it can resolve an import.
cd ~/agent/skills/dashboard/app
~/agent/skills/dashboard/scripts/ensure-deps.sh
~/agent/skills/dashboard/scripts/ensure-build.sh
# LEGACY(remove-when: the 2026-08-daemon-pidfile migration is fleet-applied): restart lines from the
# shipped self-heal migration launch this script directly with no PORT in the environment.
# `dashboard daemon start` exports one, so the fallback never fires on that path.
PORT="${PORT:-$(register-service dashboard)}"
# The local bin rather than npx, so the process the daemon records the pid of, and later
# signals, is the server itself.
exec node_modules/.bin/vite preview --port "$PORT" --host 0.0.0.0
