#!/bin/sh
set -eu

# Dashboard daemon lifecycle: start|stop|restart|status. Declares what is specific
# to the dashboard and delegates the rest to the shared runner. The `serve` launcher
# rebuilds node_modules/dist when a checkout or clean dropped them, and the service is
# private, so the app reaches it with a service key rather than the link alone.

DIR="$(cd "$(dirname "$0")" && pwd)"

exec "$HOME/agent/skills/vestad/scripts/daemon-lifecycle" "$@" \
  --session dashboard \
  --service dashboard \
  --port-mode private \
  --probe http \
  -- "$DIR/serve"
