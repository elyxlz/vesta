#!/usr/bin/env bash
# note-top <file>   [block read from stdin]
#
# Inserts a block directly UNDER the title line of a staged file, instead of
# appending it to the end.
#
# Why this exists. The rule "newest answer at the top" is one I wrote, upstreamed,
# and then broke twice in the same day (2026-08-10), because the natural motion is
# `cat >> file` and the natural motion appends. Both times a separate staging check caught it
# a second later. A rule I already know is not a control; the shell verb is.
#
#   note-top ~/agent/data/foo.md <<'EOF'
#   ## 2026-08-10 18:00: what changed
#   body...
#   EOF
#
# Deliberately dumb: it does not invent a header, because the caller knows what the
# block is and a generated header would be one more thing to trust.
#
# It DOES fill in @@NOW@@, added 2026-08-11 after writing a timestamp in the FUTURE
# three separate times in one day (13:05 written at 12:50, 13:10 at 13:09, 14:40 at
# 14:39). a separate staging check caught all three, which is the system working, but the third
# one happened in the same command as a `date` call: I had already composed the line
# before its output existed. So the verb "run date first" is not a control, because
# the estimate happens BEFORE the reading and then survives it.
# This matters more than tidiness: the timestamp is the only thing deciding which
# block wins when two contradict, so a block dated forward beats a later, truer one,
# and rereading never catches it because 14:40 looks exactly as reasonable as 14:39.
# Substituting a token the caller asked for is not the same as inventing a date.
#   note-top file <<'EOF'
#   ## @@NOW@@: what changed
# Exit 0 inserted, 1 usage/target error, 2 empty input (nothing written).

set -uo pipefail

# --append added 2026-08-13. Not every file wants newest-at-top: a running journal
# (a dated thread file, say) is chronological oldest-first by design, so its newest entry belongs at
# the END. For those I had been typing `cat >> file`, which works, and which silently
# costs the @@NOW@@ substitution: the ONE thing this script exists to do. Result the same
# night, in an entry about filling slots with plausible values, I hand-typed two headings
# as 00:47 and 01:29 when the clock said 01:03. So append mode is not a convenience, it is
# closing the bypass: wherever the block lands, the machine writes the time.
append=0
case ${1:-} in
  --append|-a) append=1; shift ;;
esac

f=${1:-}
if [ -z "$f" ]; then
  echo "usage: note-top [--append] <file>   (block on stdin)" >&2; exit 1
fi
if [ ! -f "$f" ]; then
  echo "note-top: no such file: $f" >&2; exit 1
fi
if [ -t 0 ]; then
  echo "note-top: nothing on stdin; pipe the block in" >&2; exit 2
fi

block=$(cat)
if [ -z "${block//[[:space:]]/}" ]; then
  echo "note-top: refusing to insert an empty block into $f" >&2; exit 2
fi

# @@NOW@@ becomes the real clock, in the box timezone. Announced on stderr rather than
# done silently: a substitution nobody sees is a substitution nobody can catch.
# A BACKTICKED token is being talked about, not used, so it is left alone. Found
# 2026-08-12 by this script eating the word inside a note that documented the feature:
# "indica `@@NOW@@`" came out as "indica `2026-08-12 17:35`", which is nonsense to
# every future reader. A tool that rewrites text it was only being shown is worse than
# one that misses a substitution, because the damage lands in the archive and looks
# deliberate. Mention is not use.
case $block in
  *@@NOW@@*)
    now=$(date '+%Y-%m-%d %H:%M')
    sentinel=$'\x01NOWLIT\x01'
    block=${block//\`@@NOW@@\`/$sentinel}
    if [ "$block" != "${block//@@NOW@@/}" ]; then
      block=${block//@@NOW@@/$now}
      echo "note-top: @@NOW@@ -> $now" >&2
    fi
    block=${block//$sentinel/\`@@NOW@@\`}
    ;;
esac

# Hand-typed clock times in the heading: warn if one is in the FUTURE. Added 2026-08-12 after
# five forward drifts in one day (01:40 at 01:38, 11:07 at 10:58, 15:35 at 15:29, 17:35 at
# 17:31, 17:50 at 17:34). ALWAYS forward, never back. A separate staging check caught every
# one, so the system worked, but a whole step later, once the file was already written. The
# deeper point: @@NOW@@ existed to make this impossible and I bypassed it five times by typing
# the digits, because typing them is the natural motion, so the fix is not another feature, it
# is making the bypass audible as it happens. A warning and not a refusal: a heading may quote
# a future hour legitimately, and a control that blocks good work just gets worked around.
first_line=${block%%$'\n'*}
htime=$(printf '%s' "$first_line" | grep -oE '\b([01][0-9]|2[0-3]):[0-5][0-9]\b' | head -1)
if [ -n "$htime" ]; then
  now_hm=$(date '+%H:%M')
  if [ "$htime" \> "$now_hm" ]; then
    echo "note-top: WARNING, heading says $htime and the clock says $now_hm (future)." >&2
    echo "note-top: if that is meant to be now, it is wrong; use @@NOW@@ and let it fill in." >&2
  fi
fi

# Respect a PINNED answer block. Added 2026-08-11 after this script recreated, by its own
# correct behaviour, the exact defect it was written to prevent: I fixed a digest file whose
# operative summary had sunk 500 lines down, wrote a fresh "## CURRENT ANSWER" at the top, and
# then three note-top calls in the next hour pushed it back under three research blocks. The
# rule is not "newest thing at the top", it is "the OPERATIVE ANSWER at the top, research newest
# first underneath". So if the file opens with a CURRENT ANSWER block, new blocks go BELOW it.
# The answer is the thing a future reader must hit first; raw findings are not the answer.
anchor=1
if [ "$append" -eq 1 ]; then
  # Append mode ignores the pinned block entirely: the caller has declared this file
  # chronological, so there is no "operative answer at the top" contract to protect.
  anchor=$(grep -c '' "$f")
elif head -n 40 "$f" | grep -qiE '^#{1,6} +(CURRENT ANSWER|RISPOSTA ATTUALE)'; then
  # Insert just before the heading that FOLLOWS the pinned block, so the pin stays whole.
  pin=$(grep -niE '^#{1,6} +(CURRENT ANSWER|RISPOSTA ATTUALE)' "$f" | head -1 | cut -d: -f1)
  # NOTE: plain /^#+ / and not /^#{1,6} +/. mawk does not enable ERE intervals, so the {1,6}
  # form matched NOTHING, `nxt` came back empty, and the block silently went to the END of the
  # file: a "next heading" search that never finds a heading. Caught only because the branch was
  # tested on purpose. Exactly the failure this script's own header warns about.
  nxt=$(awk -v p="$pin" 'NR>p && /^#+ / {print NR; exit}' "$f")
  if [ -n "$nxt" ]; then anchor=$((nxt-1)); else anchor=$(grep -c '' "$f"); fi
  echo "note-top: file has a pinned answer block at line $pin, inserting BELOW it" >&2
fi

# Normalise the seams: drop trailing blanks from the part above and leading blanks from the part
# below, then lay in exactly one blank line on each side of the block. Without this, inserting
# under a pinned block landed a double blank above and no blank at all below, which is the sort of
# drift that makes a staged file look hand-mangled after a dozen inserts.
strip_tail_blanks() { awk '{a[NR]=$0} END{n=NR; while(n>0 && a[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print a[i]}'; }

tmp=$(mktemp) || { echo "note-top: mktemp failed" >&2; exit 1; }
{
  head -n "$anchor" "$f" | strip_tail_blanks
  printf '\n%s\n\n' "$block"
  tail -n +$((anchor+1)) "$f" | sed '/./,$!d'
} > "$tmp" && mv "$tmp" "$f" || { echo "note-top: write failed, $f untouched" >&2; rm -f "$tmp"; exit 1; }

if [ "$append" -eq 1 ]; then
  echo "note-top: APPENDED to the end of $f (line $((anchor+1)))"
elif [ "$anchor" -eq 1 ]; then
  echo "note-top: inserted under the title of $f"
else
  echo "note-top: inserted at line $((anchor+1)) of $f, under the pinned answer block"
fi
