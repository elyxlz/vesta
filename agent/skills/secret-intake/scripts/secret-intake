#!/usr/bin/env bash
# Ask the user for a credential over a one-shot web form instead of a chat message.
#
# Registers a private vestad service, mints a short-lived key for it, prints the link to send,
# and serves a single form. The value goes straight to ~/.agent-secrets.env; it is never printed,
# logged, or written to any message store. The service key is revoked and the service
# unregistered on exit, whether the value arrived or the wait timed out.
#
# Usage: secret-intake <ENV_VAR_NAME> [--label "<what to ask for>"] [--ttl <secs>]
#   secret-intake DOUBLETICK_API_KEY --label "Doubletick API key"

set -euo pipefail

USAGE='Usage: secret-intake <ENV_VAR_NAME> [--label "<text>"] [--ttl <secs>]'
NAME="${1:?$USAGE}"
shift
LABEL="$NAME"
TTL=900
while [ $# -gt 0 ]; do
    case "$1" in
        --label) LABEL="${2:?$USAGE}"; shift 2 ;;
        --ttl) TTL="${2:?$USAGE}"; shift 2 ;;
        *) echo "$USAGE" >&2; exit 2 ;;
    esac
done

# Validate before registering anything: a bad name would otherwise mint a key and print a link
# that can only ever fail, and leave a service registered to be torn down again.
if ! printf '%s' "$NAME" | grep -qE '^[A-Z][A-Z0-9_]*$'; then
    echo "name must look like an env var (A-Z, 0-9, _), got: $NAME" >&2
    exit 2
fi

SERVICE=secret-intake
LABEL_TAG="one-shot $NAME $$"
PORT=$(register-service "$SERVICE")
KEY=$(service-key mint "$SERVICE" --label "$LABEL_TAG" --ttl "$TTL")

# revoke takes the key's ID, not the key itself, and mint only ever prints the secret, so the id
# is resolved from the label. Deleting the service alone makes the key stop working, but leaves
# the record standing until it expires.
key_id() {
    service-key list "$SERVICE" 2>/dev/null | python3 -c "
import json, sys
try:
    for k in json.load(sys.stdin).get('keys', []):
        if k.get('label') == sys.argv[1]:
            print(k['id']); break
except Exception:
    pass" "$LABEL_TAG"
}

cleanup() {
    ID=$(key_id)
    [ -n "$ID" ] && service-key revoke "$SERVICE" "$ID" >/dev/null 2>&1
    curl -sk -X DELETE "https://$BOX_HOST:$VESTAD_PORT/agents/$AGENT_NAME/services/$SERVICE" \
        -H "X-Agent-Token: $AGENT_TOKEN" >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "send the user this link, it is valid for ${TTL}s and works on a phone:"
echo "$VESTAD_TUNNEL/agents/$AGENT_NAME/$SERVICE/k/$KEY/"
echo

# Deliberately not exec: exec replaces this shell, so the EXIT trap never fires and the service
# stays registered and the key live after a credential has passed through.
python3 "$(dirname "$(readlink -f "$0")")/serve.py" "$NAME" --port "$PORT" --label "$LABEL" --timeout "$TTL"
