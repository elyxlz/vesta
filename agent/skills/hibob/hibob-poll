#!/root/.local/share/uv/tools/vesta-browser/bin/python
"""One pass over Bob, emitting a notification for anything that is genuinely new.

Run by `hibob daemon`, but safe to run by hand. Exit 0 on a clean pass, 1 on a
failure, and a FAILURE IS LOUD: an unreachable browser or a dead session must not
look like "nothing new today", because those two states are otherwise identical
from the outside and the second is the whole point of the daemon.

WHAT IT WATCHES
  - New open tasks, and tasks whose due date moved.
  - A task crossing into due-today or overdue, once each.

WHAT IT DELIBERATELY DOES NOT DO
  - It never marks, completes or writes anything in Bob. Read-only.
  - It does not notify on a task disappearing (that is the user completing it, which is
    good news they already know).

STATE: ~/agent/data/hibob/seen.json, a map of task id -> the fields we compare.
A first run with no state file records everything and notifies about NOTHING, so
installing the daemon does not dump an entire onboarding backlog into the intake.
"""
from __future__ import annotations

import datetime as dt
import json
import pathlib
import subprocess
import sys
import time

SKILL = pathlib.Path(__file__).resolve().parent
HIBOB = str(SKILL / "hibob")
STATE_DIR = pathlib.Path.home() / "agent/data/hibob"
STATE_PATH = STATE_DIR / "seen.json"
NOTIF_DIR = pathlib.Path.home() / "agent/notifications"
SOURCE = "hibob"


def _write_notification(notif_type: str, interrupt: bool, **fields) -> pathlib.Path:
    """Write `<ns>-hibob-<type>.json`, renamed into place so no partial file is read."""
    NOTIF_DIR.mkdir(parents=True, exist_ok=True)
    notif = {
        "source": SOURCE,
        "type": notif_type,
        "interrupt": interrupt,
        "timestamp": dt.datetime.now(dt.UTC).replace(microsecond=0).isoformat(),
        **fields,
    }
    path = NOTIF_DIR / f"{time.time_ns()}-{SOURCE}-{notif_type}.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(notif))
    tmp.replace(path)
    return path


def _fetch_tasks() -> list[dict]:
    """Open tasks via the CLI. Raises on anything that is not a clean, parseable pass."""
    proc = subprocess.run(
        [HIBOB, "tasks", "list", "--status", "Open", "--limit", "200", "--json"],
        capture_output=True,
        text=True,
        timeout=180,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            f"hibob tasks list exited {proc.returncode}: "
            f"{(proc.stderr or proc.stdout).strip()[:300]}"
        )
    out = proc.stdout.strip()
    if not out:
        # Empty stdout with exit 0 is the classic fake zero. Never treat it as "no tasks".
        raise RuntimeError("hibob tasks list produced NO output with exit 0")
    data = json.loads(out)
    tasks = data.get("tasks") if isinstance(data, dict) else data
    if not isinstance(tasks, list):
        raise RuntimeError(f"unexpected payload shape: {type(tasks).__name__}")
    return tasks


def _key(t: dict) -> str:
    return str(t.get("id") or t.get("triggeredTaskId") or t.get("title"))


def _snapshot(t: dict) -> dict:
    return {
        "title": t.get("title"),
        "dueDate": t.get("dueDate"),
        "taskList": t.get("taskList"),
        "flagged": [],
    }


def main() -> int:
    try:
        tasks = _fetch_tasks()
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"hibob poll FAILED: {exc}", file=sys.stderr)
        return 1

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    first_run = not STATE_PATH.is_file()
    seen: dict = {} if first_run else json.loads(STATE_PATH.read_text())

    today = dt.date.today()
    fresh: dict = {}
    new_tasks: list[dict] = []
    moved: list[tuple[dict, str]] = []
    timing: list[tuple[dict, str]] = []

    for t in tasks:
        k = _key(t)
        snap = _snapshot(t)
        prior = seen.get(k)
        snap["flagged"] = list((prior or {}).get("flagged", []))

        if prior is None:
            if not first_run:
                new_tasks.append(t)
        elif prior.get("dueDate") != snap["dueDate"]:
            moved.append((t, prior.get("dueDate")))

        due_raw = snap["dueDate"]
        due = None
        if due_raw:
            try:
                due = dt.date.fromisoformat(str(due_raw)[:10])
            except ValueError:
                due = None
        if due and not first_run:
            if due < today and "overdue" not in snap["flagged"]:
                snap["flagged"].append("overdue")
                timing.append((t, "overdue"))
            elif due == today and "today" not in snap["flagged"]:
                snap["flagged"].append("today")
                timing.append((t, "today"))

        fresh[k] = snap

    for t in new_tasks:
        _write_notification(
            "task_new",
            True,
            title=t.get("title"),
            due_date=t.get("dueDate"),
            task_list=t.get("taskList"),
        )
    for t, was in moved:
        _write_notification(
            "task_due_changed",
            False,
            title=t.get("title"),
            due_date=t.get("dueDate"),
            previous_due_date=was,
        )
    for t, kind in timing:
        _write_notification(
            "task_overdue" if kind == "overdue" else "task_due_today",
            True,
            title=t.get("title"),
            due_date=t.get("dueDate"),
            task_list=t.get("taskList"),
        )

    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(fresh, indent=1))
    tmp.replace(STATE_PATH)

    if first_run:
        print(f"first run: recorded {len(fresh)} open task(s), notified about none")
    else:
        print(
            f"{len(tasks)} open task(s); "
            f"{len(new_tasks)} new, {len(moved)} re-dated, {len(timing)} timing"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
