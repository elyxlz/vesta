{
  "name": "vesta-apps",
  "private": true,
  "workspaces": [
    "web",
    "desktop",
    "core",
    "mobile"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "expo-router": "~57.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "core:lint": "npm -w @vesta/core run lint",
    "core:check": "npm -w @vesta/core run check",
