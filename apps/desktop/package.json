{
  "name": "@vesta/desktop",
  "private": true,
  "version": "0.3.0",
  "description": "Vesta desktop app (Electron wrapper around @vesta/web)",
  "author": "elyxlz <58893694+elyxlz@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elyxlz/vesta"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run compile && node scripts/dev.mjs",
    "make-icons": "uv run --with pillow --with numpy scripts/make-icons.py",
    "compile": "tsc",
    "check": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run",
    "build": "npm -w @vesta/web run build && tsc && electron-builder --publish never",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "globals": "^17.11.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
