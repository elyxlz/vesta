{
  "name": "@vesta/core",
  "private": true,
  "version": "0.0.0",
  "description": "The Vesta client controller: protocol types, replica, transport, intents",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./release-version": "./src/protocol/release-version.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
