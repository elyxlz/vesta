{"nodes": [{"id": "agent_skills_dashboard_shadcn_rules_styling_semantic_colors", "label": "Semantic Color Tokens Rule", "file_type": "concept", "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic tokens (bg-primary, text-muted-foreground) handle light/dark via CSS variables, so raw Tailwind colors and manual dark: overrides are banned; status indicators use Badge variants or text-destructive rather than raw greens/reds."}, {"id": "agent_skills_dashboard_shadcn_rules_styling_builtin_variants_first", "label": "Built-in Variants First Rule", "file_type": "concept", "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_dashboard_shadcn_rules_styling_classname_for_layout_only", "label": "className For Layout Only Rule", "file_type": "concept", "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customization order of preference: built-in variants, then semantic color tokens, then CSS variables in the global CSS file; className is reserved for layout utilities like max-w-md/mx-auto."}, {"id": "agent_skills_dashboard_shadcn_rules_styling_cn_conditional_classes", "label": "cn() Utility For Conditional Classes", "file_type": "concept", "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_dashboard_shadcn_rules_styling_no_manual_z_index", "label": "No Manual z-index On Overlay Components", "file_type": "concept", "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dialog, Sheet, Drawer, AlertDialog, DropdownMenu, Popover, Tooltip, HoverCard manage their own stacking contexts, so adding z-50/z-[999] is never needed."}, {"id": "agent_skills_dashboard_shadcn_customization", "label": "shadcn Customization Guide (theming, CSS variables)", "file_type": "document", "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_dashboard_shadcn_rules_styling_semantic_colors", "target": "agent_skills_dashboard_shadcn_customization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_dashboard_shadcn_rules_styling_classname_for_layout_only", "target": "agent_skills_dashboard_shadcn_customization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_dashboard_shadcn_rules_styling_classname_for_layout_only", "target": "agent_skills_dashboard_shadcn_rules_styling_builtin_variants_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/dashboard/shadcn/rules/styling.md", "source_location": null, "weight": 1.0}], "hyperedges": []}