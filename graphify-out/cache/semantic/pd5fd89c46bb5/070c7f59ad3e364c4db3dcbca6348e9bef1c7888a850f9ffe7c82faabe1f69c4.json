{"nodes": [{"id": "agent_skills_essay_iter_plagiarism_prompt_plagiarism_reviewer", "label": "Paraphrase-Plagiarism Reviewer", "file_type": "concept", "source_file": "agent/skills/essay-iter/plagiarism_prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classifies each paragraph A-E (synthesis, voice-mimic, attributed long-quote, unattributed graft, too-close paraphrase), scans for verbatim sub-strings of 10+ contiguous words, and checks citation inversion (LLM drafts paraphrasing a paper but reversing its conclusion). Ruthless on misattribution, tolerant of close-but-original paraphrase that adds analysis."}, {"id": "agent_skills_essay_iter_plagiarism_prompt_discourse_feature_check", "label": "Discourse-Feature Plagiarism Check (PAN 2025 / PlagBench pattern)", "file_type": "concept", "source_file": "agent/skills/essay-iter/plagiarism_prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A paraphrase preserving the source's discourse template (claim ordering, transition pattern, evidence sequencing) with no original synthesis is flagged even with zero verbatim overlap; the fix is reordering claims, integrating a counterclaim, or interpolating the writer's own analysis."}, {"id": "agent_skills_essay_iter_plagiarism_prompt_arxiv_2412_12679", "label": "arXiv:2412.12679 (discourse-feature plagiarism detection)", "file_type": "paper", "source_file": "agent/skills/essay-iter/plagiarism_prompt.md", "source_location": null, "source_url": "https://arxiv.org/abs/2412.12679", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_essay_iter_plagiarism_prompt_plagiarism_reviewer", "target": "agent_skills_essay_iter_skill_review_loop", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "agent/skills/essay-iter/plagiarism_prompt.md", "sou