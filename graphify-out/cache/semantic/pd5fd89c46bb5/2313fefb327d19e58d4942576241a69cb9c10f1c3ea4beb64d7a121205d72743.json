{"nodes": [{"id": "agent_skills_skills_registry_skill_skills_registry_skill", "label": "Skills Registry Skill", "file_type": "document", "source_file": "agent/skills/skills-registry/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_skills_registry_skill_daemon_contract", "label": "Skill Daemon Contract", "file_type": "concept", "source_file": "agent/skills/skills-registry/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A skill running a background process implements one command named after the skill with daemon start|stop|restart|status verbs, each printing one line of JSON, pid/port records under ~/agent/data/daemons/, a log at ~/agent/logs/<skill>.log, an idempotent start returning only once up, and SIGTERM as the deliberate stop; a port-serving daemon registers its own service and a death-reporting daemon stays silent on SIGTERM."}, {"id": "agent_skills_skills_registry_skill_uv_tool_editable_install", "label": "uv tool install --editable Pattern", "file_type": "rationale", "source_file": "agent/skills/skills-registry/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skill CLIs are installed with uv tool install --editable, never pip/uv pip install -e: run from ~/agent those resolve the engine venv and drop the command into ~/agent/.venv/bin, which leads PATH and shadows the real tool, breaking the command and its daemon with an import error. uv tool install keeps the CLI isolated on ~/.local/bin."}], "edges": [{"source": "agent_skills_skills_registry_skill_skills_registry_skill", "target": "agent_skills_skills_registry_skill_daemon_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/skills-registry/SKILL.md", "source_location": null, "weight": 1.0}, {"source"