{"nodes": [{"id": "agent_skills_browser_interaction_skills_advanced_usage", "label": "Advanced browser usage", "file_type": "document", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_interaction_skills_advanced_usage_camoufox_stealth", "label": "Camoufox C++-level stealth", "file_type": "rationale", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fingerprint spoofing (navigator, screen, WebGL, timezone, fonts, webdriver=false) is done in patched Gecko C++ below anything JS can observe, so it survives CreepJS-tier toString/descriptor/stack-frame batteries that stock Chromium + CDP injection cannot. No stealth flag, no Xvfb: headless is the stealthy default."}, {"id": "agent_skills_browser_interaction_skills_advanced_usage_multi_session", "label": "BROWSER_SESSION multi-session isolation", "file_type": "concept", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each sub-agent sets a unique BROWSER_SESSION so daemons, sockets, browsers, profiles, and fingerprints are not shared; each Camoufox costs several hundred MB so 3+ concurrent sessions can OOM a small host and wide scrapes should run sequentially."}, {"id": "agent_skills_browser_interaction_skills_advanced_usage_raw_bidi", "label": "Raw BiDi escape hatch", "file_type": "concept", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For anything not wrapped by a helper; the daemon injects the current context, and over a connected Chrome the same BiDi verbs are translated to CDP, though browser-specific methods do not cross over."}, {"id": "agent_skills_browser_cli_src_vesta_browser_helpers", "label": "vesta_browser helpers module", "file_type": "code", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_cli_src_vesta_browser_helpers_http_get", "label": "http_get browser helper", "file_type": "code", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_cli_src_vesta_browser_presets", "label": "presets.py fingerprint presets", "file_type": "code", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_upstream_pr", "label": "upstream-pr skill", "file_type": "concept", "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_browser_interaction_skills_advanced_usage", "target": "agent_skills_browser_cli_src_vesta_browser_helpers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_cli_src_vesta_browser_helpers_http_get", "target": "agent_skills_browser_cli_src_vesta_browser_helpers", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "agent/skills/browser/interaction-skills/advanced-usage.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_interactio