{"nodes": [{"id": "_claude_skills_pr_monitor_skill_pr_monitor", "label": "PR Monitor Skill", "file_type": "document", "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_pr_monitor_skill_eyes_reaction_claim", "label": "Eyes Reaction as Claim-Not-Completion Dedup", "file_type": "concept", "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": "How events are deduplicated", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dedup state lives on GitHub as a reaction so it survives losing the working directory or machine; the ack is posted before the line is printed so a failure can never produce a twice-handled event, and a failed run releases the claim so usage limits are recoverable."}, {"id": "_claude_skills_pr_monitor_skill_trust_gate", "label": "Trusted Commenter Gate", "file_type": "concept", "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": "Only from people you trust", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A comment reaching the loop drives an agent holding credentials with repo write access, so the mention alone is never enough; trusted commenters carry real authority and can order exceptions to repo conventions, deliberately, because they are maintainers who know when an exception is warranted."}, {"id": "_claude_skills_pr_monitor_skill_vestabot_reply_marker", "label": "vestabot:reply Self-Wake Marker", "file_type": "concept", "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": "The agent must not wake itself", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The agent posts under an account that also belongs to a human, so the invisible HTML comment marker is the only thing separating its writing from a human's; without it the agent's own comment reads as a fresh request and it wakes itself once per poll cycle, forever."}, {"id": "_claude_skills_pr_monitor_skill_per_pr_session", "label": "Per-PR Session Resumption", "file_type": "concept", "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": "Running unattended", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The session id from a PR's first event is stored and resumed for every later event so the agent remembers what it already pushed; a per-PR lock keeps runs on one PR serial because two runs resuming one conversation would interleave their writes, while events on different PRs run concurrently."}], "edges": [{"source": "_claude_skills_pr_monitor_skill_pr_monitor", "target": "_claude_skills_pr_monitor_skill_eyes_reaction_claim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_pr_monitor_skill_pr_monitor", "target": "_claude_skills_pr_monitor_skill_trust_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_pr_monitor_skill_pr_monitor", "target": "_claude_skills_pr_monitor_skill_vestabot_reply_marker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_pr_monitor_skill_pr_monitor", "target": "_claude_skills_pr_monitor_skill_per_pr_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/pr-monitor/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_pr_monitor_skill_pr_monitor", "target": "_claude_skills_check_pr_skill_check_pr", "relation": "references", "c