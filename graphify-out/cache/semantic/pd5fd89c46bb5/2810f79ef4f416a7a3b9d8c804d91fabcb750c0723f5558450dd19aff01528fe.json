{"nodes": [{"id": "_claude_skills_check_pr_skill_check_pr", "label": "Check PR Skill", "file_type": "document", "source_file": ".claude/skills/check-pr/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_check_pr_skill_three_verdicts", "label": "NOISE/BUGGED/MERGE Verdict System", "file_type": "concept", "source_file": ".claude/skills/check-pr/SKILL.md", "source_location": "The three answers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A verdict that never says MERGE is worth as little as one that always does; NOISE is the answer maintainers most often have to reach alone, so reach it for them. CI state is deliberately excluded from the verdict since a red check is already visible on the PR page."}, {"id": "_claude_skills_check_pr_skill_proof_requirement", "label": "Checkable Proof Per Finding", "file_type": "rationale", "source_file": ".claude/skills/check-pr/SKILL.md", "source_location": "Proof", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A finding a maintainer has to re-derive costs more than it saves; every finding carries one checkable line (command+output, triggering input, or two contradicting places). Claims like 'verified locally' are about the reviewer and unusable by a reader."}], "edges": [{"source": "_claude_skills_check_pr_skill_check_pr", "target": "_claude_skills_check_pr_skill_three_verdicts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/check-pr/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_check_pr_skill_check_pr", "target": "_claude_skills_check_pr_skill_proof_requirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/check-pr/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_che