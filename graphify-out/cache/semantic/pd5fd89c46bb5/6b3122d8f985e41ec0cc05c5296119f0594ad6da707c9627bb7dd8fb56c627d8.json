{"nodes": [{"id": "agent_skills_browser_domain_skills_facebook_groups_doc", "label": "Facebook Groups Feed Mining Skill", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_facebook_groups_collect_as_you_go", "label": "Collect-As-You-Go Feed Scrolling", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": "Scrolling the feed (lazy load)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Facebook virtualizes the feed and unmounts scrolled-past posts from the DOM, so scroll-then-collect misses old posts; collection must interleave with scrolling, with a 2.5s floor because React needs ~2s to hydrate each new batch."}, {"id": "agent_skills_browser_domain_skills_facebook_groups_decode_fb_link", "label": "Facebook l.php Redirector Decoding", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": "Decoding the external-URL redirector", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_facebook_groups_rate_limit_discipline", "label": "Account-Level Rate Limit Discipline", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": "Rate-limit discipline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Facebook detects automation at the account level rather than the IP level, so a real logged-in session puts the user's account at risk; floors of 2s between scrolls, 3s between groups, max ~6 groups/hour exist to avoid checkpoints, and on symptoms the agent must stop rather than auto-resolve."}, {"id": "agent_skills_browser_domain_skills_facebook_groups_aria_anchoring", "label": "ARIA Role DOM Anchoring", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": "DOM anchors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Facebook rewrites hashed CSS class names every few weeks but ARIA roles, data-* attributes and stable URL patterns persist, so selectors anchor on role=article and href patterns; a self-inspection block is the maintenance workflow when selectors drift."}], "edges": [{"source": "agent_skills_browser_domain_skills_facebook_groups_doc", "target": "agent_skills_browser_domain_skills_facebook_groups_collect_as_you_go", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_facebook_groups_doc", "target": "agent_skills_browser_domain_skills_facebook_groups_decode_fb_link", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_facebook_groups_doc", "target": "agent_skills_browser_domain_skills_facebook_groups_rate_limit_discipline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_facebook_groups_doc", "target": "agent_skills_browser_domain_skills_facebook_groups_aria_anchoring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/facebook/groups.md", "source_location": null, "weight": 1.0}], "hyperedges": []}