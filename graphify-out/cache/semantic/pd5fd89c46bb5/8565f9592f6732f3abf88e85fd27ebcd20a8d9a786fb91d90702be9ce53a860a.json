{"nodes": [{"id": "agent_skills_onboard_skill_onboard", "label": "Onboard Skill (Invite-Only Sales + Setup)", "file_type": "document", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_onboard_skill_velvet_rope_posture", "label": "Velvet-Rope Sales Posture", "file_type": "rationale", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vesta is invite-only by design: scarcity and earned access create desire, the prospect is made to qualify and name their goal, and the invite is extended like a favor tied to that goal. A posture, not real rejection: a snob who loses the sale failed."}, {"id": "agent_skills_onboard_skill_pricing_floor", "label": "Control-Plane Pricing Floor", "file_type": "concept", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One plan, one box, with a monthly floor owned by the control plane (plan_floor_usd from onboard presets, never a figure baked into the doc); price is negotiable upward only, anchored to desire and status, and below-floor quotes are rejected server-side."}, {"id": "agent_skills_onboard_skill_whatsapp_handoff", "label": "WhatsApp Onboarding Handoff via file-host", "file_type": "concept", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A freshly created vesta cannot message its owner first, so the seed context instructs it to set up WhatsApp and publish its wa.me link via file-host at a fixed public URL the onboarding vesta polls and relays, completing the handoff without the buyer ever leaving the chat."}, {"id": "agent_skills_whatsapp_skill_whatsapp", "label": "WhatsApp Skill", "file_type": "document", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_file_host_skill_file_host", "label": "File-Host Skill", "file_type": "document", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_vesta_cloud_account_skill_vesta_cloud_account", "label": "Vesta-Cloud-Account Skill", "file_type": "document", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_stripe_pay_skill_stripe_pay", "label": "Stripe-Pay Skill", "file_type": "document", "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_onboard_skill_onboard", "target": "agent_skills_onboard_skill_velvet_rope_posture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_onboard_skill_onboard", "target": "agent_skills_onboard_skill_pricing_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_onboard_skill_onboard", "target": "agent_skills_onboard_skill_whatsapp_handoff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/onboard/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_onboard_skill_whatsapp_handoff", "target": "agent_skills_whatsapp_skill_whatsapp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, 