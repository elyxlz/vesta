{"nodes": [{"id": "agent_skills_browser_domain_skills_openstreetmap_scraping_doc", "label": "OpenStreetMap Nominatim + Overpass Guide", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_openstreetmap_scraping_nominatim", "label": "Nominatim Geocoding API", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_openstreetmap_scraping_overpass", "label": "Overpass QL Spatial Query API", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overpass enforces 2 concurrent slots per IP (not requests/sec) and returns HTML error pages with HTTP 200 when rate-limited, so responses must be checked with raw.startswith('{') before JSON parsing."}, {"id": "agent_skills_browser_domain_skills_openstreetmap_scraping_ua_blocking", "label": "OSM User-Agent Blocking (Mozilla/5.0 rejected)", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both Nominatim and Overpass block generic library UAs (Mozilla/5.0, python-requests, Wget) with 403; any descriptive app-style UA like browser-harness/1.0 passes, per Nominatim's policy requiring identifiable clients."}, {"id": "agent_skills_browser_domain_skills_openstreetmap_scraping_bbox_order_mismatch", "label": "Nominatim vs Overpass BBox Order Mismatch", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nominatim boundingbox is [south_lat, north_lat, west_lon, east_lon] while Overpass QL takes (south, west, north, east), both differing from GeoJSON order; feeding one into the other requires explicit reordering."}], "edges": [{"source": "agent_skills_browser_domain_skills_openstreetmap_scraping_doc", "target": "agent_skills_browser_domain_skills_openstreetmap_scraping_nominatim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_openstreetmap_scraping_doc", "target": "agent_skills_browser_domain_skills_openstreetmap_scraping_overpass", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_openstreetmap_scraping_doc", "target": "agent_skills_browser_domain_skills_openstreetmap_scraping_ua_blocking", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_openstreetmap_scraping_doc", "target": "agent_skills_browser_domain_skills_openstreetmap_scraping_bbox_order_mismatch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/openstreetmap/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_openstreetmap_scraping_bbox_order_mismatch", "target": "agent_skills_browser_domain_skills_openstreetmap_scraping_nominatim", "relation": "conceptu