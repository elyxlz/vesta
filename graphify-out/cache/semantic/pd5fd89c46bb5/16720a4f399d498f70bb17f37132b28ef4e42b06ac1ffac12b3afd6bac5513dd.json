{"nodes": [{"id": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_doc", "label": "Job Boards Skill: Indeed, Glassdoor, Stepstone", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_direct_urls", "label": "Direct Search URL Construction (Indeed/Glassdoor)", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": "Do this first", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typing into the homepage search box triggers bot detection immediately, so search URLs are built directly with query params and navigated to straight away."}, {"id": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_honeypot_filter", "label": "Indeed Honeypot Job Key Filter", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": "Workflow 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indeed plants decoy cards with hex-alphabet-rotation data-jk keys that duplicate real listings' titles; because every decoy shadows a genuine row, dedupe by title+company is the real defence and the key-pattern filter (is_honeypot_jk) is only a cheap extra hint, since interleaved decoy forms slip past pattern matching."}, {"id": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_mosaic_json", "label": "Indeed mosaic.providerData JSON Extraction", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": "Workflow 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indeed's search HTML embeds structured job JSON in window.mosaic.providerData, making browserless http_get extraction faster and more reliable than DOM parsing, with the browser js() path retained as fallback when the key changes or a CAPTCHA appears."}, {"id": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_captcha_detection", "label": "CAPTCHA Page Detection (is_captcha_page)", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": "Bot detection and rate limiting", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indeed's CAPTCHA renders as a clean-looking page that raises no error, so every goto must be followed by an explicit multi-signal check (URL, title, body text) before trusting extraction results."}, {"id": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_glassdoor_login_wall", "label": "Glassdoor Login Wall Handling (Job Boards)", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": "Workflow 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_doc", "target": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_direct_urls", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_doc", "target": "agent_skills_browser_domain_skills_job_boards_indeed_glassdoor_honeypot_filter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/job-boards/indeed-glassdoor.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_job_b