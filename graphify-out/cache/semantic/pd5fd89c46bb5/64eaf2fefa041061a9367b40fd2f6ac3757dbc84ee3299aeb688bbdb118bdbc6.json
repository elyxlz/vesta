{"nodes": [{"id": "agent_skills_browser_domain_skills_thetechgeeks_pricing_doc", "label": "The Tech Geeks AU Ubiquiti Pricing Guide", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/thetechgeeks/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_thetechgeeks_pricing_shopify_js_endpoint", "label": "Shopify .js Product JSON Endpoint", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/thetechgeeks/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shopify exposes canonical product JSON at /products/{handle}.js, so one http_get replaces the goto + wait + screenshot + regex flow for title, SKU, and price."}, {"id": "agent_skills_browser_domain_skills_thetechgeeks_pricing_stock_price_distrust", "label": "Stock/Price Sanity Gate", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/thetechgeeks/pricing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The .js available flag is unreliable (in-stock items marked false for backorder) and sold-out listings carry stale junk prices (a $3,080 listing vs ~$420-630 street), so real stock is cross-checked against the DOM and any price deviating >2x from another AU vendor or MSRP is presumed wrong; only in-stock prices land in a final table."}], "edges": [{"source": "agent_skills_browser_domain_skills_thetechgeeks_pricing_doc", "target": "agent_skills_browser_domain_skills_thetechgeeks_pricing_shopify_js_endpoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/thetechgeeks/pricing.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_thetechgeeks_pricing_doc", "target": "agent_skill