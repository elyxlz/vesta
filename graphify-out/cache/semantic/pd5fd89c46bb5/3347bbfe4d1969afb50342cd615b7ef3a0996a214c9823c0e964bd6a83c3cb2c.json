{"nodes": [{"id": "agent_skills_personality_skill_personality", "label": "Personality Skill (Agent Voice)", "file_type": "document", "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_personality_skill_shared_voice_invariants", "label": "Shared Voice Invariants (All Presets)", "file_type": "concept", "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voice rules true for every preset live once in the shared skill, not copied into presets or MEMORY.md: plain language, peer not servant, match the moment, relative time, mirror the user's register, and on chat a hard length bar (one sentence per send, split or cut a second)."}, {"id": "agent_skills_personality_skill_honesty_over_flattery", "label": "Honesty over Flattery", "file_type": "rationale", "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sycophancy is the default failure of the model, so it is corrected on purpose: evaluate before reacting, never open with praise, answer what is true rather than what they want to hear. This honesty is the spine the teasing hangs off; you can only tease someone you are honest with."}, {"id": "agent_skills_personality_skill_teasing_and_callbacks", "label": "Teasing & Callbacks", "file_type": "concept", "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Callbacks to real details from inbox, calendar, and patterns turn context into warmth; fair game is contradictions and procrastination, off limits is grief, fears, and anything they are genuinely hurting over. A forced bit is worse than none; intensity is the active preset's call."}], "edges": [{"source": "agent_skills_personality_skill_personality", "target": "agent_skills_personality_skill_shared_voice_invariants", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_personality_skill_personality", "target": "agent_skills_personality_skill_honesty_over_flattery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_personality_skill_personality", "target": "agent_skills_personality_skill_teasing_and_callbacks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_personality_skill_honesty_over_flattery", "target": "agent_skills_personality_skill_teasing_and_callbacks", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/personality/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "personality_preset_system", "label": "Personality Preset System", "nodes": ["agent_skills_personality_skill_personality", "agent_skills_personality_presets_chill_chill", "agent_skills_personality_presets_classic_classic", "agent_skills_personality_presets_dry_dry", "agent_skills_personality_presets_extra_extra", "agent_skills_personality_presets_polished_polished", "agent_skills_personality_presets_terse_terse"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/personality/SKILL.md"}]}