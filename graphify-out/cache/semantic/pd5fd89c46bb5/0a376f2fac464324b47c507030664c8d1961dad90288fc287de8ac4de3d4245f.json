{"nodes": [{"id": "_github_workflows_release_pipeline_release_pipeline", "label": "Release Pipeline Workflow", "file_type": "code", "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggered only by a published prerelease so release-only jobs never appear as skipped PR checks. Reuses ci.yml for validation and artifact builds, gates all publishing on the live suite and a Linux smoke test of the exact release-built binary, and pushes per-arch image digests assembled into one multi-arch tag."}, {"id": "_github_workflows_release_pipeline_push_image", "label": "push-image Job (per-arch native build, cache-from only)", "file_type": "code", "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds each arch natively (no QEMU) and pushes by digest only after the gates pass. cache-from only, never cache-to: a green run must never publish an image assembled from a poisoned cross-run cache; the pre-gate warm jobs populate the read-only caches."}, {"id": "_github_workflows_release_pipeline_mobile_testflight", "label": "mobile-testflight Job", "file_type": "code", "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gated on the release gates but not on publish-release, letting TestFlight delivery run in parallel with the GHCR push; accepted tradeoff is that a TestFlight build of a since-reverted release may reach the internal beta group. Runs only when the release body carries the mobile-delivery: testflight marker and extracts the whats-new block as the changelog."}, {"id": "_github_workflows_release_pipeline_revert_failed_release", "label": "revert-failed-release Job", "file_type": "code", "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On any pipeline failure: deletes the GHCR tag and GitHub release (with its git tag), then reverts the version-bump commit only when it is still the master tip, so a commit that landed after the bump is never clobbered."}, {"id": "_github_workflows_release_pipeline_publish_release", "label": "publish-release Job (asset upload)", "file_type": "code", "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_release_pipeline_release_pipeline", "target": "_github_workflows_ci_ci_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_pipeline_release_pipeline", "target": "_github_workflows_live_tests_live_agent_tests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_release_workflow", "target": "_github_workflows_release_pipeline_release_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_pipeline_release_pipeline", "target": "_github_workflows_release_pipeline_push_image", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_pipeline_release_pipeline", "target": "_github_workflows_release_pipeline_publish_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_pipeline_release_pipeline", "target": "_github_workflows_release_pipeline_mobile_testflight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_pipeline_release_pipeline", "target": "_github_workflows_release_pipeline_revert_failed_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_release_workflow", "target": "_github_workflows_release_pipeline_mobile_testflight", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_pipeline_revert_failed_release", "target": "_github_workflows_release_release_workflow", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_release_pipeline_release_pipeline", "target": "_github_workflows_ci_version_check", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".github/workflows/release-pipeline.yml", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "vesta_release_lifecycle", "label": "Vesta Release Lifecycle (bump -> pipeline -> promote)", "nodes": ["_github_workflows_release_release_workflow", "_github_workflows_release_pipeline_release_pipeline", "_github_workflows_live_tests_live_agent_tests", "_github_work