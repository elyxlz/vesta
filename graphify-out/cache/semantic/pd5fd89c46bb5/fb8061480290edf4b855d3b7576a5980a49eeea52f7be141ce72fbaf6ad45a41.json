{"nodes": [{"id": "agent_skills_microsoft_setup_microsoft_setup", "label": "Microsoft Setup Guide", "file_type": "document", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_microsoft_setup_auth_setup_flow", "label": "Microsoft auth setup Flow (device-code vs browser handover)", "file_type": "concept", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One command provisions mail, calendar, and Teams; personal accounts default to device-code, work/school tenants default to browser handover up front because locked tenants almost always block the default public client, avoiding a wasted device-code round-trip. The daemon silently re-mints tokens from the saved browser profile so the user signs in once."}, {"id": "agent_skills_microsoft_setup_owa_rest_fallback", "label": "OWA REST Fallback Backend", "file_type": "concept", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For tenants that block Graph entirely, a browser-captured outlook.office.com token drives an OWA REST backend; --backend auto falls back to it on Graph permission errors. Every command works on both backends except block/unblock which are Graph-only. Token pasting lets the user keep password and MFA off the agent machine."}, {"id": "agent_skills_microsoft_setup_draft_only_mode", "label": "EMAIL_DRAFT_ONLY Draft-Only Mode", "file_type": "concept", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EMAIL_DRAFT_ONLY=1 hard-disables send/reply/forward before any backend call as a CLI-level safety guarantee rather than a behavioral promise; it guards both Graph and OWA-REST so it holds for OWA-REST-only work accounts too."}, {"id": "agent_skills_microsoft_setup_first_use_data_gathering", "label": "First-Use Data Gathering", "file_type": "concept", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The moment an account connects, proactively read hundreds of sent/inbox emails and the calendar to learn voice, contacts, and the personal picture; reading what was just connected is the whole point of connecting it, so it starts immediately without gating on fresh permission, fanning out background subagents to preserve context."}, {"id": "agent_skills_vestad_skill_vestad", "label": "Vestad Skill", "file_type": "document", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_contacts_skill_contacts", "label": "Contacts Skill", "file_type": "document", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_skill_browser", "label": "Browser Skill", "file_type": "document", "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_microsoft_setup_microsoft_setup", "target": "agent_skills_vestad_skill_vestad", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_setup_microsoft_setup", "target": "agent_skills_microsoft_setup_auth_setup_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_setup_microsoft_setup", "target": "agent_skills_microsoft_setup_owa_rest_fallback", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_setup_microsoft_setup", "target": "agent_skills_microsoft_setup_draft_only_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_setup_microsoft_setup", "target": "agent_skills_microsoft_setup_first_use_data_gathering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_setup_owa_rest_fallback", "target": "agent_skills_browser_skill_browser", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_setup_first_use_data_gathering", "target": "agent_skills_personality_skill_teasing_and_callbacks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_setup_first_use_data_gathering", "target": "agent_skills_contacts_skill_contacts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/SETUP.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "headless_interactive_auth_flows", "label": "Headless Interactive Auth Flows (user relays a code)", "nodes": ["agent_skills_icloud_photos_skill_sms_2fa_login_flow", "agent_skills_microsoft_setup_auth_setup