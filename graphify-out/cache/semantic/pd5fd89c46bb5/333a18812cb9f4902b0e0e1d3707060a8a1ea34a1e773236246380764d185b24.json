{"nodes": [{"id": "_claude_skills_motion_performance_audit_resources_tier_reference_tier_reference", "label": "Render Pipeline Tier Reference", "file_type": "document", "source_file": ".claude/skills/motion/performance-audit/resources/tier-reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_motion_performance_audit_resources_tier_reference_layout_thrashing", "label": "Layout Thrashing (F-Tier)", "file_type": "concept", "source_file": ".claude/skills/motion/performance-audit/resources/tier-reference.md", "source_location": "F-Tier: Layout Thrashing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interleaved DOM reads and writes force synchronous layout multiple times per frame because each layout-triggering read after a write must recalculate immediately; fixed by batching via Motion's frame.read()/frame.update()."}, {"id": "_claude_skills_motion_performance_audit_resources_tier_reference_css_variable_inheritance_bomb", "label": "CSS Variable Inheritance Bomb", "file_type": "concept", "source_file": ".claude/skills/motion/performance-audit/resources/tier-reference.md", "source_location": "CSS Variable Inheritance Bombs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Animating a CSS variable on :root/html/body forces style recalculation on the entire DOM tree every frame (~8ms/frame at ~1300 elements, the whole 120fps budget); fix by scoping the variable, registering @property with inherits:false, or animating the target property directly."}, {"id": "_claude_skills_motion_performance_audit_resources_tier_reference_flip_technique", "label": "FLIP Technique (B-Tier)", "file_type": "concept", "source_file": ".claude/skills/motion/performance-audit/resources/tier-reference.md", "source_location": "B-Tier: DOM Setup + S/A-Tier Animation", "source_url": null, "captured_at": null, "author": null,