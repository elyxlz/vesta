{"nodes": [{"id": "agent_skills_whatsapp_skill_whatsapp_skill", "label": "WhatsApp Skill", "file_type": "document", "source_file": "agent/skills/whatsapp/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_whatsapp_skill_connect_verb", "label": "whatsapp connect Verb", "file_type": "concept", "source_file": "agent/skills/whatsapp/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single setup verb: picks managed vs QR on its own, runs the whole handshake synchronously in the daemon, and returns a terminal status with a next: step, so there is no step for the agent to sequence and the recompile, websocket, and polling races are gone by construction. Idempotent outside an active QR session."}, {"id": "agent_skills_whatsapp_skill_short_bubble_rule", "label": "Short-Bubble Texting Rule", "file_type": "concept", "source_file": "agent/skills/whatsapp/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "send-message rejects walls (over ~220 chars, or any text after a full stop) so the agent re-sends as several short calls, one thought each; --longform is the only escape hatch, reserved for genuine reference material the user asked for."}], "edges": [{"source": "agent_skills_whatsapp_skill_whatsapp_skill", "target": "agent_skills_whatsapp_setup_whatsapp_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/whatsapp/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_whatsapp_skill_whatsapp_skill", "target": "agent_skills_whatsapp_managed_auth_managed_auth_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/whatsapp/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_wha