{"nodes": [{"id": "_claude_skills_design_engineering_design_design_guide", "label": "Design Engineering Guide (animations.dev)", "file_type": "document", "source_file": ".claude/skills/design-engineering/design.md", "source_location": null, "source_url": "https://animations.dev/", "captured_at": null, "author": "Emil Kowalski", "contributor": null}, {"id": "_claude_skills_design_engineering_design_animation_decision_framework", "label": "Animation Decision Framework", "file_type": "concept", "source_file": ".claude/skills/design-engineering/design.md", "source_location": "The Animation Decision Framework", "source_url": null, "captured_at": null, "author": "Emil Kowalski", "contributor": null, "rationale": "Frequency of use decides whether to animate at all: 100+/day actions get no animation ever because repetition makes motion feel slow and disconnected; rare first-time flows can add delight. Every animation must answer 'why does this animate?'."}, {"id": "_claude_skills_design_engineering_design_sonner_principles", "label": "Sonner Principles (Building Loved Components)", "file_type": "concept", "source_file": ".claude/skills/design-engineering/design.md", "source_location": "The Sonner Principles", "source_url": null, "captured_at": null, "author": "Emil Kowalski", "contributor": null, "rationale": "Good defaults matter more than options because most users never customize; handle edge cases invisibly; use transitions not keyframes for dynamic UI since keyframes restart from zero on interruption; cohesion between motion, design, and even naming is what makes a component feel right."}], "edges": [{"source": "_claude_skills_design_engineering_design_design_guide", "target": "_claude_skills_design_engineering_design_animation_decision_framework", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/design-engineering/design.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_design_engineeri