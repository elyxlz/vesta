{"nodes": [{"id": "agent_skills_moneypot_skill_moneypot", "label": "Moneypot Shared Expense Tracker Skill", "file_type": "document", "source_file": "agent/skills/moneypot/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_moneypot_skill_integer_minor_units", "label": "Integer Minor Units Amount Storage", "file_type": "rationale", "source_file": "agent/skills/moneypot/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amounts are stored as integer minor units (pence/cents) so there is no float drift; equal splits distribute leftover pennies to the first members, and stored FX rates keep old balances stable when rates move."}, {"id": "agent_skills_moneypot_skill_joint_account_pattern", "label": "Joint-Account-as-Member Pattern", "file_type": "concept", "source_file": "agent/skills/moneypot/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pooled account is modeled as just another member rather than a special entity: fills are transfers into it, out-of-pocket joint costs are expenses for it, and contributions reports who paid in and what the account still owes."}], "edges": [{"source": "agent_skills_moneypot_skill_moneypot", "target": "agent_skills_moneypot_skill_integer_minor_units", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/moneypot/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_moneypot_skill_moneypot", "target": "agent_skills_moneypot_skill_joint_account_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/moneypot/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}