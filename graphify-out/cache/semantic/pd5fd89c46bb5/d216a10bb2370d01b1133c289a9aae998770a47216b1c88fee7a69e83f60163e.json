{"nodes": [{"id": "agent_skills_browser_domain_skills_linkedin_invitation_manager_doc", "label": "LinkedIn Invitation Manager Skill", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_linkedin_invitation_manager_aria_selectors", "label": "Aria-Label Invitation Button Selectors", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": "Button selectors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accept and Ignore buttons use different aria-label grammars (curly apostrophe in Accept's), so each is matched independently and never derived from the other; the filter chip count is the authoritative loop guard."}, {"id": "agent_skills_browser_domain_skills_linkedin_invitation_manager_anchor_accept_trap", "label": "Follows-You Anchor Accept Trap", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": "Trap: follows you cards", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On 'follows you' invitations the Accept control is an <a> whose href points at the current page; clicks follow the href as a same-URL soft-nav and neither dispatched MouseEvents nor CDP coordinate clicks fire the accept handler, so there is no known way to accept these via CDP: route tagName==='A' rows to Ignore or skip them."}, {"id": "agent_skills_browser_domain_skills_linkedin_invitation_manager_reload_pagination", "label": "Reload-Not-Scroll Pagination", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": "Pagination", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only ~10 cards render at a time and the next batch never auto-mounts after accepting (LinkedIn swaps in acknowledgments + suggestions, and scroll triggers no lazy-load), so the loop must reload the filter URL each cycle and use the chip count as the guard."}], "edges": [{"source": "agent_skills_browser_domain_skills_linkedin_invitation_manager_doc", "target": "agent_skills_browser_domain_skills_linkedin_invitation_manager_aria_selectors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_linkedin_invitation_manager_doc", "target": "agent_skills_browser_domain_skills_linkedin_invitation_manager_anchor_accept_trap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_linkedin_invitation_manager_doc", "target": "agent_skills_browser_domain_skills_linkedin_invitation_manager_reload_pagination", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_linkedin_invitation_manager_anchor_accept_trap", "target": "agent_skills_browser_domain_skills_framer_editor_synthetic_event_rejection", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "agent/skills/browser/domain-skills/linkedin/invitation-manager.md", "source_location": null, "weight": 1.0}], "hyperedges": []}