{"nodes": [{"id": "agent_skills_browser_domain_skills_producthunt_scraping_doc", "label": "Product Hunt Scraping Guide", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/producthunt/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_producthunt_scraping_data_test_selectors", "label": "Product Hunt data-test Selectors", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/producthunt/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "data-test attributes are the most reliable selectors on the React SPA; different page types use different prefixes (post-item- on homepage/leaderboard, product: on topics/categories, spotlight-result-product- on search)."}, {"id": "agent_skills_browser_domain_skills_producthunt_scraping_leaderboard_urls", "label": "Product Hunt Leaderboard URL Patterns", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/producthunt/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The homepage is a fixed 30-item set that never lazy-loads more and hides today's votes for the first 4 hours; date-parameterized leaderboard pages give complete daily lists with real vote counts."}, {"id": "agent_skills_browser_domain_skills_producthunt_scraping_new_tab_workaround", "label": "new_tab() Workaround for goto ERR_ABORTED", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/producthunt/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "goto() may return ERR_ABORTED for producthunt.com in some browser sessions, so navigation always uses new_tab() followed by an explicit wait for React rendering."}], "edges": [{"source": "agent