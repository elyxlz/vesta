{"nodes": [{"id": "agent_skills_microsoft_references_email_email_reference", "label": "Microsoft Email Command Reference", "file_type": "document", "source_file": "agent/skills/microsoft/references/email.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_microsoft_references_email_delayed_send", "label": "Delayed Send and Undo", "file_type": "concept", "source_file": "agent/skills/microsoft/references/email.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Send/reply/forward wait 30 seconds by default as one persisted client-wide setting; each send creates a provider draft with a pending id, the daemon dispatches due drafts, and undo cancels right up until dispatch. A message cut off mid-dispatch may already have been sent, so check the Sent folder before undoing or resending."}, {"id": "agent_skills_microsoft_references_email_body_saved_to_disk", "label": "Email Body Saved to Disk, Not Inline", "file_type": "rationale", "source_file": "agent/skills/microsoft/references/email.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "email get always saves the body under ~/.microsoft/emails/ and strips it from the JSON response, returning only saved_to plus a short preview; the full body.content is intentionally never returned inline to keep agent context small."}], "edges": [{"source": "agent_skills_microsoft_references_email_email_reference", "target": "agent_skills_microsoft_setup_microsoft_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/microsoft/references/email.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_microsoft_references_email_email_reference", "target": "agent_skills_microsoft_references_email_delayed_send", "relation": "references", "confidence": "EXTR