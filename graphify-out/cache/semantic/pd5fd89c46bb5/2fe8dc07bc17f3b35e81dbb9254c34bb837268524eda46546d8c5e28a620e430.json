{"nodes": [{"id": "_claude_skills_issues_to_prs_skill_issues_to_prs", "label": "Issues to PRs Skill", "file_type": "document", "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_issues_to_prs_skill_two_phase_workflow", "label": "Two-Phase Build-Then-Review Workflow", "file_type": "rationale", "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 2 (review+trim) is never folded into phase 1 because an agent told to review its own work before the PR exists stops on the review and strands uncommitted work; order is load-bearing: implement, verify, commit, push, open PR, only then review."}, {"id": "_claude_skills_issues_to_prs_skill_mutation_proven_coverage", "label": "Mutation-Proven Test Coverage", "file_type": "concept", "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": "Hard rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'The test passes' means nothing: revert the fix, watch the test fail, restore. A test that cannot fail is decoration, and coverage claims must be re-proven after trimming rather than assumed."}, {"id": "_claude_skills_issues_to_prs_skill_verify_claims_rule", "label": "Verify Claims, Never Relay", "file_type": "rationale", "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": "Hard rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An issue's diagnosis and a PR body's coverage claim are assertions by someone with blind spots; passing them on launders an assertion into a fact the user acts on. The issue's diagnosis is a hypothesis, not a spec."}], "edges": [{"source": "_claude_skills_issues_to_prs_skill_issues_to_prs", "target": "_claude_skills_issues_to_prs_skill_two_phase_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_issues_to_prs_skill_issues_to_prs", "target": "_claude_skills_issues_to_prs_skill_mutation_proven_coverage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_issues_to_prs_skill_issues_to_prs", "target": "_claude_skills_issues_to_prs_skill_verify_claims_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_issues_to_prs_skill_verify_claims_rule", "target": "_claude_skills_check_pr_skill_proof_requirement", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_issues_to_prs_skill_issues_to_prs", "target": "_claude_skills_issue_triage_skill_conventional_commits_titles", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".claude/skills/issues-to-prs/SKILL.md", "source_location": "branch naming <type>/<slug>", "weight": 1.0}], "hyperedges": []}