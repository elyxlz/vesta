{"nodes": [{"id": "agent_skills_browser_domain_skills_openalex_scraping_doc", "label": "OpenAlex Academic Graph Guide", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/openalex/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_openalex_scraping_polite_pool", "label": "OpenAlex Polite Pool (mailto param)", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/openalex/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding mailto= to every request opts into the polite pool, which is more reliable than the common pool; it is a query parameter with no session, so it must ride every call."}, {"id": "agent_skills_browser_domain_skills_openalex_scraping_abstract_inverted_index", "label": "Abstract Inverted Index Reconstruction", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/openalex/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OpenAlex returns abstracts as an inverted index (word to positions map) rather than plain text due to publisher agreements; the abstract is rebuilt by sorting (position, word) pairs."}, {"id": "agent_skills_browser_domain_skills_openalex_scraping_cursor_pagination", "label": "OpenAlex Cursor Pagination", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/openalex/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page-based pagination hard-stops at 10,000 results (HTTP 400 past page 50 at per-page=200); cursor=* pagination has no such limit and is required for bulk harvests."}], "edges": [{"source": "agent_skills_browser_domain_skills_openalex_scraping_doc", "target": "agent_skills_browser_domai