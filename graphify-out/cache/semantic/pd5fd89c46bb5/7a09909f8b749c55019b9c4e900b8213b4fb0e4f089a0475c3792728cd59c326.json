{"nodes": [{"id": "agent_skills_browser_domain_skills_news_aggregation_multi_source_doc", "label": "Multi-Source News Aggregation Guide", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/news-aggregation/multi-source.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_news_aggregation_multi_source_rss_first_strategy", "label": "RSS-First Fetch Strategy", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/news-aggregation/multi-source.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RSS via http_get takes ~0.1s per feed versus 3-8s for a browser load; lead with feeds, fall back to raw HTML parsing, and only use the browser when a site blocks HTTP entirely (Reuters 403s regardless of User-Agent)."}, {"id": "agent_skills_browser_domain_skills_news_aggregation_multi_source_parallel_fetch_pattern", "label": "Parallel RSS Fetch Pattern", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/news-aggregation/multi-source.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ThreadPoolExecutor over 7 feeds measured a 4.3x speedup (0.70s sequential vs 0.16s parallel)."}, {"id": "agent_skills_browser_domain_skills_news_aggregation_multi_source_atom_namespace_parsing", "label": "Atom Namespace Parsing (The Verge)", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/news-aggregation/multi-source.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Verge's feed is Atom, not RSS 2.0, so the naive .//item selector returns 0 items; entries must be found with an explicit atom namespace dict."}, {"id": "agent_skills_browser_domain_skills_news_aggregation_multi_source_access_decis