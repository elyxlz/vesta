{"nodes": [{"id": "agent_skills_stripe_pay_skill_stripe_pay_skill", "label": "Stripe Pay Skill (Link for Agents)", "file_type": "document", "source_file": "agent/skills/stripe-pay/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_stripe_pay_skill_spend_request_flow", "label": "Link Spend Request Approval Flow", "file_type": "concept", "source_file": "agent/skills/stripe-pay/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each purchase mints a single-use virtual card released only after the user approves the spend in their Link app, so the agent never holds the real card; --context must be at least 100 characters written for the approving user, the unmasked card touches disk only at one 0600 file that is deleted after use, caps are enforced by Stripe not the skill, and a denied request is never retried."}, {"id": "agent_skills_stripe_pay_skill_machine_payment_protocol", "label": "Machine Payment Protocol (MPP)", "file_type": "concept", "source_file": "agent/skills/stripe-pay/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some merchants take a one-time programmatic shared payment token instead of a card form; the spend request is created with --credential-type shared_payment_token and paid via link-cli mpp pay."}], "edges": [{"source": "agent_skills_stripe_pay_skill_stripe_pay_skill", "target": "agent_skills_stripe_pay_setup_stripe_pay_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/stripe-pay/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_stripe_pay_skill_stripe_pay_skill", "target": "agent_skills_stripe_pay_skill_spend_request_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ag