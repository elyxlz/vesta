{"nodes": [{"id": "agent_skills_dashboard_design_skill_dashboard_design", "label": "Dashboard Design Guide", "file_type": "document", "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design judgment inside a fixed system: fonts, base theme, and color tokens are synced from the main app (index.css, shadcn) and must not change, so the design material is hierarchy, composition, structure, color as signal, motion, restraint, and copy. Brand-identity, hero, and invent-a-palette guidance from the upstream plugin was dropped on purpose."}, {"id": "agent_skills_dashboard_design_skill_density_and_sizing", "label": "Density and Sizing Rules", "file_type": "concept", "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A high-density command center: default shadcn sizes are too large, so they are overridden (text-sm default, h-8 controls, p-3/p-2 wrappers, gap-2 grids, col-span-1 for ~90% of widgets) so a lot fits without feeling cramped."}, {"id": "agent_skills_dashboard_design_skill_progressive_disclosure", "label": "Progressive Disclosure", "file_type": "concept", "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A priority on a surface this dense, embedded, and mobile-friendly: show the essential at a glance and reveal detail in dialogs, sheets, overflow menus, and collapsibles; it is what keeps widgets calm and makes the narrow frame work."}, {"id": "agent_skills_dashboard_design_skill_iframe_embedding_constraint", "label": "Never Owns the Viewport (iframe Constraint)", "file_type": "rationale", "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dashboard renders inside an iframe in a card in the main app's layout on desktop and mobile. Horizontal overflow is clipped rather than scrolled because on mobile the user swipes sideways to move between dashboard, chat, and logs tabs; a sideways-scrolling page would swallow that swipe. Widgets must reflow to the frame, never rely on horizontal scroll or fixed viewport heights."}, {"id": "agent_skills_dashboard_design_skill_color_as_signal", "label": "Color Carries Meaning, Not Decoration", "file_type": "concept", "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structure uses the semantic Tailwind tokens auto-synced into index.css so the dashboard matches the wider app; raw scales (text-green-500) are reserved for signal (up/down, status, category) used consistently, because a widget washed in one accent has no signal left to give."}, {"id": "agent_skills_dashboard_design_skill_frontend_design_plugin", "label": "anthropics/claude-code frontend-design Plugin (MIT)", "file_type": "document", "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_dashboard_design_skill_dashboard_design", "target": "agent_skills_dashboard_design_skill_frontend_design_plugin", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_dashboard_design_skill_dashboard_design", "target": "agent_skills_dashboard_design_skill_density_and_sizing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "a