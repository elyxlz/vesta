cn_skill_shadcn_ui_skill", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/dashboard/design/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}