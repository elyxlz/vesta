{"nodes": [{"id": "agent_skills_samsung_tv_skill_samsung_tv_skill", "label": "Samsung TV Skill", "file_type": "document", "source_file": "agent/skills/samsung-tv/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_samsung_tv_skill_find_tv_ip", "label": "find_tv_ip", "file_type": "code", "source_file": "agent/skills/samsung-tv/SKILL.md", "source_location": "line 26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The TV's IP can change after power cycles, so the ARP table is scanned for the TV's MAC instead of hardcoding a static IP; a valid (0x2) entry wins over a stale one."}, {"id": "agent_skills_samsung_tv_skill_get_screen_id", "label": "get_screen_id", "file_type": "code", "source_file": "agent/skills/samsung-tv/SKILL.md", "source_location": "line 191", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_samsung_tv_skill_save_auth", "label": "save_auth", "file_type": "code", "source_file": "agent/skills/samsung-tv/SKILL.md", "source_location": "line 204", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_samsung_tv_skill_load_auth", "label": "load_auth", "file_type": "code", "source_file": "agent/skills/samsung-tv/SKILL.md", "source_location": "line 212", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_samsung_tv_skill_play_youtube_video", "label": "play_youtube_video", "file_type": "code", "source_file": "agent/skills/samsung-tv/SKILL.md", "source_location": "line 223", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saved Lounge auth is restored first to refresh the lounge token without triggering the TV pairing popup; the full pair_with_screen_id flow (which shows the popup) is only the fallback when saved state is invalid."}, {"id": "agent_s