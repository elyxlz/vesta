{"nodes": [{"id": "_github_workflows_ci_ci_workflow", "label": "CI Workflow", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on master pushes, PRs (path-filtered via detect-changes), and workflow_call from the release pipeline with release_artifacts=true. Master push runs are never cancelled because merge-gate-ci reports cancelled siblings as failures. Cargo and npm network settings are hardened against transient registry flakes."}, {"id": "_github_workflows_ci_detect_changes", "label": "detect-changes Job (path filtering + build toggles)", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skips redundant validation of the release version-bump commit (the pipeline re-validates the same SHA). vestad's filter includes agent/** because vestad embeds the agent home via build.rs, so agent-only changes can break vestad. BUILD_MAC_UNIVERSAL and BUILD_ANDROID toggles live here."}, {"id": "_github_workflows_ci_version_check", "label": "version-check Job", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ci_build_agent_image", "label": "build-agent-image Job (cache warmer)", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds the agent image once and exports a mode=max GHA cache under the agent-image-amd64 scope so test-integration and check-vestad hit warm layers instead of cold-building twice in parallel; it never pushes anywhere."}, {"id": "_github_workflows_ci_test_integration", "label": "test-integration Job", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frees tens of GB of preinstalled runner toolchains because the suite exports multi-GB containers into restic in parallel and exhausts stock runner disk. Retries once for Docker daemon hiccups, but surfaces multi-attempt runs as warning annotations so flakiness is visible, not silently absorbed."}, {"id": "_github_workflows_ci_check_vestad", "label": "check-vestad Job", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_ci_build_vestad", "label": "build-vestad Job (static musl binaries)", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds static musl binaries natively per arch. No CLOUDFLARE_* secrets: vestad does not bake a Cloudflare token into the public binary; self-hosters bring their own tunnel credentials. Triggered by the web closure (core || web) because build.rs embeds only the web bundle."}, {"id": "_github_workflows_ci_merge_gate_ci", "label": "merge-gate-ci Job (single required check)", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single branch-protection required check: aggregates every CI job with if: always() and fails if any needed job failed or was cancelled. The job ID name must stay stable because branch protection references it."}, {"id": "_github_workflows_ci_hermetic_agent_image_build", "label": "Hermetic Agent Image Build (vesta:local from checkout)", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docker-based jobs build the agent image from THIS checkout and run with VESTAD_AGENT_IMAGE=vesta:local, so PRs are validated against their own agent code and Dockerfile, never the previously released ghcr.io :latest image."}], "edges": [{"source": "_github_workflows_ci_ci_workflow", "target": "_github_actions_install_rust_action_install_rust", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_ci_workflow", "target": "_github_workflows_ci_detect_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_ci_workflow", "target": "_github_workflows_ci_merge_gate_ci", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_merge_gate_ci", "target": "_github_workflows_ci_detect_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_merge_gate_ci", "target": "_github_workflows_ci_test_integration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_merge_gate_ci", "target": "_github_workflows_ci_check_vestad", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_ci_merge_gate_ci", "target": "_github_workflows_ci_build_vestad", "relation": "references", "confidence":