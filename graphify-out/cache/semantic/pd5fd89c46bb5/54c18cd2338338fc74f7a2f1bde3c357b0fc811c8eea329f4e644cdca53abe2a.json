{"nodes": [{"id": "agent_skills_browser_domain_skills_tiktok_upload_doc", "label": "TikTok Studio Upload Guide", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/tiktok/upload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_tiktok_upload_upload_flow", "label": "TikTok Upload Flow (attach, caption, schedule, submit)", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/tiktok/upload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_tiktok_upload_scroll_wheel_time_picker", "label": "Scroll-Wheel Time Picker Interaction", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/tiktok/upload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The schedule time picker is a virtual scroll list, not a native select: JS .click() does not work on its items, each scroll(dy=32) steps exactly one unit, and only CDP coordinate clicks register."}, {"id": "agent_skills_browser_domain_skills_tiktok_upload_caption_clearing", "label": "Caption Contenteditable Clearing", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/tiktok/upload.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TikTok pre-fills the caption with the filename and the contenteditable appends on type; it must be cleared with End + Backspace keystrokes, never by setting innerHTML, which breaks React state."}], "edges": [{"source": "agent_skills_browser_domain_skills_tiktok_upload_doc", "target": "agent_skills_browser_domain_skills_tiktok_upload_upload_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills