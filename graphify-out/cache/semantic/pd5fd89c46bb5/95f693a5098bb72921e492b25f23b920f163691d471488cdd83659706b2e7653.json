{"nodes": [{"id": "agent_skills_browser_domain_skills_wellfound_scraping_datadome", "label": "DataDome anti-bot (Wellfound page GETs)", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocks all non-browser HTTP with 403 + captcha challenge; cookies are TLS-fingerprint-bound so replay never works. Resolves silently in a real Chrome session via JS fingerprinting (2-4s after load), hence the mandatory wait(5)."}, {"id": "agent_skills_browser_domain_skills_wellfound_scraping_cloudflare_bot_management", "label": "Cloudflare Bot Management (Wellfound API POSTs)", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second anti-bot layer, evidenced by Cf-Mitigated: challenge header; blocks POST /graphql from non-browser sessions, forcing GraphQL calls to run as fetch() inside the browser."}, {"id": "agent_skills_browser_domain_skills_wellfound_scraping_dismiss_wellfound_login_modal", "label": "dismiss_wellfound_login_modal", "file_type": "code", "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_wellfound_scraping_wellfound_is_blocked", "label": "wellfound_is_blocked (challenge detection)", "file_type": "code", "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_wellfound_scraping_graphql_api", "label": "Wellfound GraphQL via in-browser fetch", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires a browser session cookie, a Rails csrf-token meta tag, and Cloudflare Bot Management to have passed; only works as fetch() inside the browser, never from server-side http_get."}, {"id": "agent_skills_browser_domain_skills_wellfound_scraping_apollo_state", "label": "window.__APOLLO_STATE__ / window.gon extraction", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wellfound is Rails + React + Apollo, not Next.js, so there is no __NEXT_DATA__; structured data lives in the Apollo Client cache, window.gon, or inline script tags instead."}], "edges": [{"source": "agent_skills_browser_domain_skills_wellfound_scraping_wellfound_is_blocked", "target": "agent_skills_browser_domain_skills_wellfound_scraping_datadome", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_wellfound_scraping_graphql_api", "target": "agent_skills_browser_domain_skills_wellfound_scraping_cloudflare_bot_management", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_wellfound_scraping_cloudflare_bot_management", "target": "agent_skills_browser_interaction_skills_cloudflare_403_vs_js_challenge_js_challenge", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "agent/skills/browser/domain-skills/wellfound/scraping.md", "source_location": null, "wei