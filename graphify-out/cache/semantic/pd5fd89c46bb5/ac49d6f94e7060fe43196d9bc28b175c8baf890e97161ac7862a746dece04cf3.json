{"nodes": [{"id": "agent_skills_proactive_check_skill_proactive_check_skill", "label": "Proactive Check Skill", "file_type": "document", "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_proactive_check_skill_daemon_liveness_preflight", "label": "Daemon Liveness Preflight", "file_type": "rationale", "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A daemon can die silently (container up, daemon down), and a dead messaging daemon means the agent cannot reach the user at all, so every proactive tick first turns each restart-skill start line into a status call and revives anything reporting running:false."}, {"id": "agent_skills_proactive_check_skill_nudging_vs_holding", "label": "Nudging vs Holding", "file_type": "concept", "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A goal blocked on the user for more than one wake window is nudged rather than held silently (if they asked to be pushed), capped at one task-nudge thread per check so nudging never crowds out broader proactive work."}], "edges": [{"source": "agent_skills_proactive_check_skill_proactive_check_skill", "target": "agent_skills_proactive_check_skill_daemon_liveness_preflight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_proactive_check_skill_proactive_check_skill", "target": "agent_skills_proactive_check_skill_nudging_vs_holding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_proactive_check_skill_proactive_check_skill", "target": "agent_skills_restart_skill_restart_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_proactive_check_skill_proactive_check_skill", "target": "agent_skills_tasks_skill_tasks_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_proactive_check_skill_daemon_liveness_preflight", "target": "agent_skills_restart_skill_daemons_block", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/proactive-check/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}