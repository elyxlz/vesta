{"nodes": [{"id": "agent_skills_browser_domain_skills_g2_scraping_doc", "label": "G2 B2B Software Reviews Skill", "file_type": "document", "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_g2_scraping_datadome", "label": "DataDome TLS-Fingerprint Anti-Bot", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": "Anti-bot verdict", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DataDome 5.6.1 blocks every http_get with a silent JS challenge; the datadome cookie is bound to the originating TLS/JA3 fingerprint so replay yields rt:'i' regardless of headers, while real Chrome via CDP passes automatically because it presents a genuine fingerprint plus browser APIs."}, {"id": "agent_skills_browser_domain_skills_g2_scraping_vendor_api", "label": "G2 Vendor REST API", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": "Fastest approach: official vendor API", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_domain_skills_g2_scraping_microdata", "label": "G2 Schema.org Microdata Extraction", "file_type": "rationale", "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": "Gotchas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "G2 is a Rails/Hotwire app with no __NEXT_DATA__; schema.org itemtype/itemprop attributes baked into SSR HTML are the reliable extraction path because they serve SEO purposes and stay stable across visual redesigns, unlike hashed CSS classes."}, {"id": "agent_skills_browser_domain_skills_g2_scraping_login_modal", "label": "G2 Scroll-Triggered Sign-In Modal", "file_type": "concept", "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": "Handling the sign-in modal", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The modal triggers on scroll rather than on load, so all visible review cards must be extracted before any scroll; more reviews come from ?page=N pagination instead of scrolling."}], "edges": [{"source": "agent_skills_browser_domain_skills_g2_scraping_doc", "target": "agent_skills_browser_domain_skills_g2_scraping_datadome", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_g2_scraping_doc", "target": "agent_skills_browser_domain_skills_g2_scraping_vendor_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_g2_scraping_doc", "target": "agent_skills_browser_domain_skills_g2_scraping_microdata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_g2_scraping_doc", "target": "agent_skills_browser_domain_skills_g2_scraping_login_modal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_domain_skills_g2_scraping_doc", "target": "agent_skills_browser_domain_skills_glassdoor_scraping_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/domain-skills/g2/scraping.md", "source_location": "Do not apply Glassdoor-st