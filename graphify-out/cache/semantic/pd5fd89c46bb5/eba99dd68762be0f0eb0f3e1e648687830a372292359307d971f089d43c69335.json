{"nodes": [{"id": "agent_skills_browser_skill_browser", "label": "Browser Skill (Camoufox Stealth Browsing)", "file_type": "document", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_skill_camoufox", "label": "Camoufox Anti-Detection Browser", "file_type": "concept", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stealth is structural, not a flag: fingerprint spoofing happens in C++ below JS, so headless leaks nothing (unlike stock Chromium). Each profile gets one coherent fingerprint, stable across restarts, different across profiles. Not baked into the Docker image: fetched and sha256-verified on first launch so the image stays small and the browser updates without a rebuild."}, {"id": "agent_skills_browser_skill_webdriver_bidi", "label": "WebDriver BiDi Protocol", "file_type": "concept", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_skill_a11y_snapshot_refs", "label": "Accessibility Snapshot with Numbered Refs (e1, e2)", "file_type": "concept", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refs are semantic, survive layout changes within a snapshot, and work on ~95% of pages; coordinate clicks (input.performActions real pointer events) are the fallback for shadow DOM, cross-origin iframes, and elements with no ARIA role. Refs are only valid from the most recent snapshot; navigation invalidates them all."}, {"id": "agent_skills_browser_skill_escalation_ladder", "label": "Stealth -> Handover -> Remote-Control Escalation Ladder", "file_type": "rationale", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sites gating on account trust (sign-in walls, banking, locked tenants) rather than fingerprint are better handled by handing the headed browser to the user for a one-time sign-in than by fighting detection; the session persists in the shared profile. Remote-controlling the user's own Chrome over a tunnel is the last resort, only when their specific logged-in session is needed."}, {"id": "agent_skills_browser_skill_handover", "label": "Browser Handover (User Signs In on Agent's Headed Browser)", "file_type": "concept", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agent_skills_browser_skill_boring_cause_first", "label": "Rule Out the Boring Cause Before Suspecting Anti-Bot", "file_type": "rationale", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the browser is genuinely stealth, a hang or blank page is almost never a block: heavy-JS SPAs fire the load event late or never, so open/navigate times out even though the page rendered. Snapshot anyway or navigate with wait:interactive before considering a block. Same for stuck forms: a submit that won't advance is a validation error (empty required field, unticked checkbox, hidden duplicate form), not detection. A false wall abandoned is worse than a real wall pushed through."}, {"id": "agent_skills_browser_cli_src_vesta_browser_helpers_http_get", "label": "http_get Helper (Browser CLI helpers.py)", "file_type": "code", "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agent_skills_browser_skill_browser", "target": "agent_skills_browser_skill_camoufox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_skill_browser", "target": "agent_skills_browser_skill_webdriver_bidi", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_skill_browser", "target": "agent_skills_browser_skill_a11y_snapshot_refs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_skill_escalation_ladder", "target": "agent_skills_browser_skill_browser", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_skill_boring_cause_first", "target": "agent_skills_browser_skill_browser", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_skill_escalation_ladder", "target": "agent_skills_browser_skill_handover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "agent_skills_browser_skill_browser", "target": "agent_skills_browser_setup_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "agent/skills/browser/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "browser_domain_skill_recipe_library", "label": "Browser Domain-Skill Recipe Library", "nodes": ["agent_skills_browser_skill_browser", 