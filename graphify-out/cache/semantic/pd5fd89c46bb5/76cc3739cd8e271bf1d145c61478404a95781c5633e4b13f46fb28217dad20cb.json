{"nodes": [{"id": "_claude_skills_babysit_prs_skill_babysit_prs", "label": "Babysit PRs Skill", "file_type": "document", "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_babysit_prs_skill_per_pr_loop", "label": "Per-PR Fix Loop (Worktree-Isolated)", "file_type": "rationale", "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": "Per-PR loop", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always run in an isolated git worktree, never the invoking session's checkout, because the current checkout may hold unrelated in-progress work on a different branch."}, {"id": "_claude_skills_babysit_prs_skill_hard_rules", "label": "Babysit PRs Hard Rules", "file_type": "rationale", "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": "Hard rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skill is aggressive about fixing, not bypassing: never weaken tests, never --force push, never --no-verify, never edit workflows to skip checks, max 3 attempts per PR to avoid burning CI minutes and noisy comment threads."}, {"id": "_claude_skills_babysit_prs_skill_code_vs_test_decision", "label": "Code vs Test Decision Rule", "file_type": "rationale", "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": "Code vs test", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default assumption when a test fails is that the code is wrong; fix the test only when the PR explicitly intends the behavior change, the assertion is fragile, or the owner documented flakiness. If undecidable in 5 minutes, post diagnosis instead of guessing."}], "edges": [{"source": "_claude_skills_babysit_prs_skill_babysit_prs", "target": "_claude_skills_babysit_prs_skill_per_pr_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_babysit_prs_skill_babysit_prs", "target": "_claude_skills_babysit_prs_skill_hard_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_babysit_prs_skill_hard_rules", "target": "_claude_skills_babysit_prs_skill_code_vs_test_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": "Hard rules", "weight": 1.0}, {"source": "_claude_skills_babysit_prs_skill_babysit_prs", "target": "_claude_skills_issues_to_prs_skill_issues_to_prs", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/babysit-prs/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": []}